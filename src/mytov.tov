import { createInterface } from "node:readline"
import { execFileSync, spawn } from "node:child_process"
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs"
import * as path from "node:path"

// mytov draws UI itself, like mygo's package ui — no webview. Tov has no
// FFI, so a frame becomes a display list: JSON lines on the stdin of a
// small helper process that owns an NSWindow and paints the list with
// AppKit/CoreText. Input comes back on its stdout the same way.

// --- views ------------------------------------------------------------

export type KeyEv = { code: int, key: string, mods: int, repeat: bool }

// Event handlers a region of the layout can carry. `focusable` puts the
// region in the Tab chain; a focused region gets key events first.
export type Handlers = {
  click?: () => void,
  // press fires on mousedown and drag on pointer moves while pressed,
  // with the point in view coordinates — both stay captured by the hit
  // region until mouseup, wherever the pointer goes.
  press?: (x: f64, y: f64) => void,
  drag?: (x: f64, y: f64) => void,
  rightClick?: (x: f64, y: f64) => void,
  hover?: (hovering: bool) => void,
  scroll?: (dx: f64, dy: f64) => void,
  key?: (e: KeyEv) => void,
  // Accessibility: role (AXRole, e.g. "AXButton") and label for VoiceOver.
  ax?: { role: string, label: string },
  // Editing channel for text widgets: "insert" committed text,
  // "command" an editing selector name (e.g. moveLeft, deleteBackward),
  // "marked" IME preedit text, "paste" a clipboard reply.
  text?: (op: string, s: string) => void,
  focusable?: bool,
}

export type View =
  | { kind: "text", s: string, size: f64, bold: bool, color: string }
  | { kind: "button", title: string, onClick: () => void }
  | { kind: "events", child: View, on: Handlers }
  | { kind: "custom", w: f64, h: f64, paint: (box: Box, st: WidgetState) => Cmd[], on?: Handlers, regions?: (box: Box) => Hit[] }
  | { kind: "column", gap: f64, children: View[] }
  | { kind: "row", gap: f64, children: View[] }
  | { kind: "pad", inset: f64, child: View }
  | { kind: "scroll", st: ScrollState, child: View }
  | { kind: "split", st: SplitState, left: View, right: View }
  | { kind: "bg", color: string, radius: f64, stroke: string, child: View }
  | { kind: "overlay", child: View, layer: View | undefined, anchor: string, dim: bool, capture: bool, at?: Box }
  | { kind: "list", st: ScrollState, count: int, rowH: f64, row: (i: int) => View }
  | { kind: "spacer" }

export type TextOpts = { size?: f64, bold?: bool, color?: string }

export function text(s: string, opts?: TextOpts): View {
  return { kind: "text", s, size: opts?.size ?? 15, bold: opts?.bold ?? false, color: opts?.color ?? "#111111" }
}

export function button(title: string, onClick: () => void): View {
  return { kind: "button", title, onClick }
}

export function column(children: View[], gap?: f64): View {
  return { kind: "column", gap: gap ?? 0, children }
}

export function row(children: View[], gap?: f64): View {
  return { kind: "row", gap: gap ?? 0, children }
}

export function pad(inset: f64, child: View): View {
  return { kind: "pad", inset, child }
}

export function spacer(): View {
  return { kind: "spacer" }
}

// Mutable scroll offset for scroll()/list(); held by the app.
export class ScrollState {
  offset = 0.0
  max = 0.0 // content minus viewport, refreshed each layout pass

  scrollBy(dy: f64) {
    this.offset = Math.max(0.0, Math.min(this.max, this.offset + dy))
  }
}

// Child laid out inside a clipped viewport, scrolled by st.offset. The view
// fills its share of the parent like a spacer, but keeps its contents.
export function scroll(child: View, st: ScrollState): View {
  return { kind: "scroll", st, child }
}

// Split position 0..1 for split(); held by the app, dragged by the divider.
export class SplitState {
  fraction = 0.5
}

// Draggable two-pane row: left pane gets fraction of the width.
export function split(left: View, right: View, st: SplitState): View {
  return { kind: "split", st, left, right }
}

// Accessibility label/role on a region; VoiceOver reads it and AXPress
// routes to the region's click handler.
export function ax(child: View, role: string, label: string): View {
  return on(child, { ax: { role, label } })
}

// Fills its box with a solid color behind the child.
export function bg(color: string, child: View, radius?: f64, stroke?: string): View {
  return { kind: "bg", color, radius: radius ?? 0.0, stroke: stroke ?? "", child }
}

// Layered view: `layer` draws and hit-tests above `child`. anchor is
// "center" | "top" | "bottom" | "left" | "right" (layer keeps intrinsic
// size except left/right, which stretch vertically; top/bottom stretch
// horizontally? no — top/bottom center horizontally, anchored to edge).
// dim adds a scrim behind the layer; capture blocks input below it.
export function overlay(child: View, layer: View | undefined, opts?: { anchor?: string, dim?: bool, capture?: bool, at?: Box }): View {
  return { kind: "overlay", child, layer, anchor: opts?.anchor ?? (opts?.at !== undefined ? "at" : "center"), dim: opts?.dim ?? false, capture: opts?.capture ?? false, at: opts?.at }
}

// Virtualized rows: only the visible slice is laid out per frame.
export function list(count: int, rowH: f64, row: (i: int) => View, st: ScrollState): View {
  return { kind: "list", st, count, rowH, row }
}

// Attach event handlers to a view's region. Handlers on an inner view win
// over an `on` wrapper's where they overlap (inner is more specific).
export function on(child: View, handlers: Handlers): View {
  return { kind: "events", child, on: handlers }
}

// --- layout ------------------------------------------------------------

export type Size = { w: f64, h: f64 }
export type Box = { x: f64, y: f64, w: f64, h: f64 }
export type Hit = { box: Box, on: Handlers, clip?: Box }

export type Cmd =
  | { kind: "rect", x: f64, y: f64, w: f64, h: f64, color: string, radius: f64, stroke: string, lw: f64 }
  | { kind: "oval", x: f64, y: f64, w: f64, h: f64, color: string }
  | { kind: "text", x: f64, y: f64, w: f64, h: f64, s: string, size: f64, color: string, bold: bool }
  | { kind: "image", x: f64, y: f64, w: f64, h: f64, path: string }
  | { kind: "line", x: f64, y: f64, w: f64, h: f64, color: string, lw: f64 }
  | { kind: "pushClip", x: f64, y: f64, w: f64, h: f64 }
  | { kind: "popClip" }
export type Frame = { frame: Cmd[] }

// Text metrics. The render pass pre-measures every run through the helper
// (CoreText) and caches by key; the estimate is the fallback for callers
// that never warmed the cache, like tests.
const textCache: Map<string, Size> = new Map()
const inflight: Set<string> = new Set()

type TextRun = { s: string, size: f64, bold: bool }

function textKey(r: TextRun): string {
  return `${r.s}${r.size}${r.bold}`
}

// CoreText size when the render pass has warmed the cache, otherwise the
// estimate. Views laid out through run() always get the real number.
export function textSize(s: string, size: f64, bold: bool): Size {
  return textCache.get(`${s}${size}${bold}`) ?? { w: s.chars().length * size * (bold ? 0.6 : 0.55), h: size * 1.35 }
}

function textW(s: string, size: f64, bold: bool): f64 {
  return textSize(s, size, bold).w
}

function addRun(inout out: TextRun[], inout seen: Set<string>, s: string, size: f64, bold: bool) {
  const k = textKey({ s, size, bold })
  if (!seen.has(k) && !textCache.has(k) && !inflight.has(k)) {
    seen.add(k)
    out.push({ s, size, bold })
  }
}

// Every text run a view tree will draw, deduplicated by cache key.
function collectRuns(v: View, inout out: TextRun[], inout seen: Set<string>) {
  switch (v.kind) {
    case "text":
      addRun(&out, &seen, v.s, v.size, v.bold)
      break
    case "button":
      addRun(&out, &seen, v.title, 15.0, true)
      break
    case "pad":
      collectRuns(v.child, &out, &seen)
      break
    case "events":
      collectRuns(v.child, &out, &seen)
      break
    case "scroll":
    case "bg":
      collectRuns(v.child, &out, &seen)
      break
    case "split":
      collectRuns(v.left, &out, &seen)
      collectRuns(v.right, &out, &seen)
      break
    case "overlay":
      collectRuns(v.child, &out, &seen)
      if (v.layer !== undefined) collectRuns(v.layer, &out, &seen)
      break
    case "custom":
    case "list":
      break
    case "column":
    case "row":
      for (const c of v.children) collectRuns(c, &out, &seen)
      break
    case "spacer":
      break
  }
}

export function measure(v: View): Size {
  switch (v.kind) {
    case "text":
      return { w: textW(v.s, v.size, v.bold), h: v.size * 1.35 }
    case "button":
      return { w: textW(v.title, 15.0, true) + 32, h: 30.0 }
    case "spacer":
      return { w: 0, h: 0 }
    case "pad": {
      const s = measure(v.child)
      return { w: s.w + v.inset * 2, h: s.h + v.inset * 2 }
    }
    case "events":
      return measure(v.child)
    case "custom":
      return { w: v.w, h: v.h }
    case "scroll":
    case "list":
    case "split":
      return { w: 0, h: 0 }
    case "bg":
    case "overlay":
      return measure(v.child)
    case "column": {
      let w = 0
      let h = v.gap * (v.children.length - 1)
      for (const c of v.children) {
        const s = measure(c)
        if (s.w > w) w = s.w
        h += s.h
      }
      return { w, h }
    }
    case "row": {
      let w = v.gap * (v.children.length - 1)
      let h = 0
      for (const c of v.children) {
        const s = measure(c)
        w += s.w
        if (s.h > h) h = s.h
      }
      return { w, h }
    }
  }
}

// Indexes into the hit list of the live window's hovered / pressed /
// focused region; -1 means none. Hit index stands in for view identity:
// trees are rebuilt every render, so state is stable only while the tree
// keeps the same shape.
export type Styles = { hover: int, pressed: int, focus: int }

// The state of a widget's own hit region, handed to paint.
export type WidgetState = { hover: bool, pressed: bool, focused: bool }

const NO_HIT: Styles = { hover: -1, pressed: -1, focus: -1 }

// spacers, scroll views and lists all expand to fill leftover space.
function isFlex(v: View): bool {
  return v.kind === "spacer" || v.kind === "scroll" || v.kind === "list" || v.kind === "split" || v.kind === "bg"
}

// Lays `v` out inside `box`. Rows and columns center their stack on the
// main axis and each child on the cross axis; spacers split leftover
// space evenly.
function tagClip(h: Hit, clip?: Box): Hit {
  if (clip === undefined) return h
  return { box: h.box, on: h.on, clip }
}

export function place(v: View, box: Box, inout cmds: Cmd[], inout hits: Hit[], st?: Styles, clip?: Box) {
  const style = st ?? NO_HIT
  switch (v.kind) {
    case "text":
      cmds.push({ kind: "text", x: box.x, y: box.y, w: box.w, h: box.h, s: v.s, size: v.size, color: v.color, bold: v.bold })
      break
    case "button": {
      const idx = hits.length
      const color = style.pressed === idx ? "#045cc4" : style.hover === idx ? "#1a86ff" : "#0a7aff"
      cmds.push({ kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color, radius: 6.0, stroke: "", lw: 0.0 })
      if (style.focus === idx) {
        cmds.push({ kind: "rect", x: box.x - 2.5, y: box.y - 2.5, w: box.w + 5.0, h: box.h + 5.0, color: "", radius: 8.0, stroke: "#6bb3ff", lw: 2.0 })
      }
      const th = textSize(v.title, 15.0, true).h
      cmds.push({ kind: "text", x: box.x, y: box.y + (box.h - th) / 2, w: box.w, h: th, s: v.title, size: 15.0, color: "#ffffff", bold: true })
      hits.push(tagClip({ box, on: { click: v.onClick, focusable: true, ax: { role: "AXButton", label: v.title } } }, clip))
      break
    }
    case "events":
      // Register the wrapper's region before placing the child so the
      // child's own regions come later in the list and win hit-testing.
      hits.push(tagClip({ box, on: v.on }, clip))
      place(v.child, box, &cmds, &hits, st, clip)
      break
    case "custom": {
      const idx = hits.length
      const ws: WidgetState = { hover: style.hover === idx, pressed: style.pressed === idx, focused: style.focus === idx }
      const regions = v.regions
      if (regions !== undefined) {
        for (const h of regions(box)) hits.push(tagClip(h, clip))
      } else if (v.on !== undefined) {
        hits.push(tagClip({ box, on: v.on! }, clip))
      }
      for (const c of v.paint(box, ws)) cmds.push(c)
      break
    }
    case "scroll": {
      const stt = v.st
      const contentH = measure(v.child).h
      stt.max = Math.max(0.0, contentH - box.h)
      stt.offset = Math.max(0.0, Math.min(stt.max, stt.offset))
      hits.push(tagClip({ box, on: { scroll: (dx, dy) => stt.scrollBy(dy) } }, clip))
      cmds.push({ kind: "pushClip", x: box.x, y: box.y, w: box.w, h: box.h })
      place(v.child, { x: box.x, y: box.y - stt.offset, w: box.w, h: contentH }, &cmds, &hits, st, box)
      if (stt.max > 0) {
        // scrollbar thumb, right edge
        const frac = box.h / contentH
        const th = Math.max(24.0, box.h * frac)
        const ty = box.y + (box.h - th) * (stt.offset / stt.max)
        cmds.push({ kind: "rect", x: box.x + box.w - 4.0, y: ty, w: 3.0, h: th, color: "#00000033", radius: 1.5, stroke: "", lw: 0.0 })
      }
      cmds.push({ kind: "popClip" })
      break
    }
    case "list": {
      const stt = v.st
      const contentH = v.count * v.rowH
      stt.max = Math.max(0.0, contentH - box.h)
      stt.offset = Math.max(0.0, Math.min(stt.max, stt.offset))
      hits.push(tagClip({ box, on: { scroll: (dx, dy) => stt.scrollBy(dy) } }, clip))
      cmds.push({ kind: "pushClip", x: box.x, y: box.y, w: box.w, h: box.h })
      const first = Math.max(0, Math.trunc(stt.offset / v.rowH))
      const last = Math.min(v.count, Math.trunc((stt.offset + box.h) / v.rowH) + 1)
      for (let i = first; i < last; i += 1) {
        place(v.row(i), { x: box.x, y: box.y + i * v.rowH - stt.offset, w: box.w, h: v.rowH }, &cmds, &hits, st, box)
      }
      if (stt.max > 0) {
        const frac = box.h / contentH
        const th = Math.max(24.0, box.h * frac)
        const ty = box.y + (box.h - th) * (stt.offset / stt.max)
        cmds.push({ kind: "rect", x: box.x + box.w - 4.0, y: ty, w: 3.0, h: th, color: "#00000033", radius: 1.5, stroke: "", lw: 0.0 })
      }
      cmds.push({ kind: "popClip" })
      break
    }
    case "split": {
      // fraction of the width for the left pane; 6pt divider between.
      const stt = v.st
      const lw = Math.max(0.0, (box.w - 6.0) * Math.max(0.0, Math.min(1.0, stt.fraction)))
      const div: Box = { x: box.x + lw, y: box.y, w: 6.0, h: box.h }
      place(v.left, { x: box.x, y: box.y, w: lw, h: box.h }, &cmds, &hits, st, clip)
      place(v.right, { x: box.x + lw + 6.0, y: box.y, w: box.w - lw - 6.0, h: box.h }, &cmds, &hits, st, clip)
      const di = hits.length
      hits.push(tagClip({ box: div, on: {
        press: () => {},
        drag: (x) => { stt.fraction = Math.max(0.0, Math.min(1.0, (x - box.x) / box.w)) },
      } }, clip))
      cmds.push({ kind: "rect", x: div.x + 2.5, y: div.y, w: 1.0, h: div.h, color: style.hover === di || style.pressed === di ? "#0a7aff" : "#d1d1d6", radius: 0.0, stroke: "", lw: 0.0 })
      break
    }
    case "bg":
      cmds.push({ kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: v.color, radius: v.radius, stroke: v.stroke, lw: v.stroke === "" ? 0.0 : 1.0 })
      place(v.child, box, &cmds, &hits, st, clip)
      break
    case "overlay": {
      place(v.child, box, &cmds, &hits, st, clip)
      if (v.layer === undefined) break
      const layer = v.layer
      if (v.dim) cmds.push({ kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "#00000055", radius: 0.0, stroke: "", lw: 0.0 })
      // A capture region under the layer's regions eats clicks that would
      // otherwise fall through to the child.
      if (v.capture || v.dim) hits.push(tagClip({ box, on: {} }, clip))
      const s = measure(layer)
      const m = 12.0
      let lb: Box
      switch (v.anchor) {
        case "at": {
          const at = v.at ?? { x: box.x + m, y: box.y + m, w: 0, h: 0 }
          lb = { x: Math.min(at.x, box.x + box.w - s.w - m), y: Math.min(at.y, box.y + box.h - s.h - m), w: s.w, h: s.h }
          break
        }
        case "top": lb = { x: box.x + (box.w - s.w) / 2, y: box.y + m, w: s.w, h: s.h }; break
        case "bottom": lb = { x: box.x + (box.w - s.w) / 2, y: box.y + box.h - s.h - m, w: s.w, h: s.h }; break
        case "left": lb = { x: box.x + m, y: box.y + m, w: s.w, h: box.h - m * 2 }; break
        case "right": lb = { x: box.x + box.w - s.w - m, y: box.y + m, w: s.w, h: box.h - m * 2 }; break
        default: lb = { x: box.x + (box.w - s.w) / 2, y: box.y + (box.h - s.h) / 2, w: s.w, h: s.h }; break
      }
      place(layer, lb, &cmds, &hits, st, clip)
      break
    }
    case "pad":
      place(v.child, { x: box.x + v.inset, y: box.y + v.inset, w: box.w - v.inset * 2, h: box.h - v.inset * 2 }, &cmds, &hits, st, clip)
      break
    case "spacer":
      break
    case "column": {
      const sizes = v.children.map(measure)
      let fixed = v.gap * (v.children.length - 1)
      let spacers = 0
      let j = 0
      for (const c of v.children) {
        fixed += sizes[j]!.h
        if (isFlex(c)) spacers += 1
        j += 1
      }
      const extra = Math.max(0, box.h - fixed)
      const perSpacer = spacers > 0 ? extra / spacers : 0
      let y = box.y + (spacers > 0 ? 0 : extra / 2)
      let i = 0
      for (const c of v.children) {
        const s = sizes[i]!
        const flex = isFlex(c)
        const h = flex ? perSpacer : s.h
        const w = flex ? box.w : Math.min(s.w, box.w)
        place(c, { x: flex ? box.x : box.x + (box.w - w) / 2, y, w, h }, &cmds, &hits, st, clip)
        y += h + v.gap
        i += 1
      }
      break
    }
    case "row": {
      const sizes = v.children.map(measure)
      let fixed = v.gap * (v.children.length - 1)
      let spacers = 0
      let j = 0
      for (const c of v.children) {
        fixed += sizes[j]!.w
        if (isFlex(c)) spacers += 1
        j += 1
      }
      const extra = Math.max(0, box.w - fixed)
      const perSpacer = spacers > 0 ? extra / spacers : 0
      let x = box.x + (spacers > 0 ? 0 : extra / 2)
      let i = 0
      for (const c of v.children) {
        const s = sizes[i]!
        const flex = isFlex(c)
        const w = flex ? perSpacer : s.w
        const h = Math.min(s.h, box.h)
        place(c, { x, y: box.y + (box.h - h) / 2, w, h }, &cmds, &hits, st, clip)
        x += w + v.gap
        i += 1
      }
      break
    }
  }
}

export function layout(v: View, w: f64, h: f64, st?: Styles): { frame: Frame, hits: Hit[] } {
  let cmds: Cmd[] = []
  let hits: Hit[] = []
  place(v, { x: 0, y: 0, w, h }, &cmds, &hits, st)
  return { frame: { frame: cmds }, hits }
}

// --- window shim -------------------------------------------------------
//
// argv: <title> <width> <height>
// stdin:  {"frame":[cmd,...]} one JSON object per line; cmd is
//         {"kind":"rect",x,y,w,h,color,radius} or {"kind":"text",x,y,w,h,s,size,color,bold}
// stdout: {"event":"mousedown","x":..,"y":..} / {"event":"resize","w":..,"h":..}
// The view is flipped, so all coordinates are top-left origin.
// env MYTOV_CLICK="x,y" posts a synthetic mousedown ~0.7s after launch.

const HELPER_SRC = `#import <Cocoa/Cocoa.h>

static void emit(const char *s) {
  fputs(s, stdout);
  fputc('\\n', stdout);
  fflush(stdout);
}

static void emitJSON(NSDictionary *d) {
  NSData *data = [NSJSONSerialization dataWithJSONObject:d options:0 error:nil];
  fwrite(data.bytes, 1, data.length, stdout);
  fputc('\\n', stdout);
  fflush(stdout);
}

static NSFont *fontFor(NSDictionary *d) {
  double size = [d[@"size"] doubleValue];
  return [d[@"bold"] boolValue] ? [NSFont boldSystemFontOfSize:size]
                               : [NSFont systemFontOfSize:size];
}

static NSColor *color(NSString *hex) {
  unsigned r = 0, g = 0, b = 0, a = 255;
  const char *s = hex.UTF8String;
  if (s[0] == '#') s++;
  if (strlen(s) == 8) sscanf(s, "%02x%02x%02x%02x", &r, &g, &b, &a);
  else sscanf(s, "%02x%02x%02x", &r, &g, &b);
  return [NSColor colorWithSRGBRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:a / 255.0];
}

static double num(NSDictionary *d, NSString *k) { return [d[k] doubleValue]; }

@interface AxEl : NSAccessibilityElement
@property(nonatomic) int idx;
@end
@implementation AxEl
- (BOOL)accessibilityPerformPress {
  emitJSON(@{ @"event": @"axpress", @"i": @(self.idx) });
  return YES;
}
@end

@interface ListView : NSView
@property(nonatomic, strong) NSArray *displayList;
@property(nonatomic, strong) NSArray *axList;
@end

static ListView *gView;

@implementation ListView
@synthesize axList = _axList;
- (void)drawRect:(NSRect)dirty {
  [[NSColor whiteColor] setFill];
  NSRectFill(dirty);
  for (NSDictionary *cmd in self.displayList) {
    NSString *kind = cmd[@"kind"];
    if ([kind isEqualToString:@"rect"]) {
      NSRect box = NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"));
      double rad = num(cmd, @"radius");
      NSBezierPath *path = rad > 0 ? [NSBezierPath bezierPathWithRoundedRect:box xRadius:rad yRadius:rad]
                                   : [NSBezierPath bezierPathWithRect:box];
      NSString *fill = cmd[@"color"];
      if (fill.length > 0) { [color(fill) setFill]; [path fill]; }
      NSString *stroke = cmd[@"stroke"];
      if (stroke.length > 0) {
        [color(stroke) setStroke];
        path.lineWidth = num(cmd, @"lw") > 0 ? num(cmd, @"lw") : 1.0;
        [path stroke];
      }
    }
    if ([kind isEqualToString:@"pushClip"]) {
      [NSGraphicsContext saveGraphicsState];
      NSRectClip(NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h")));
    }
    if ([kind isEqualToString:@"popClip"]) {
      [NSGraphicsContext restoreGraphicsState];
    }
    if ([kind isEqualToString:@"image"]) {
      NSImage *img = [[NSImage alloc] initWithContentsOfFile:cmd[@"path"]];
      [img drawInRect:NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"))
             fromRect:NSZeroRect operation:NSCompositingOperationSourceOver fraction:1 respectFlipped:YES hints:nil];
    }
    if ([kind isEqualToString:@"line"]) {
      NSBezierPath *p = [NSBezierPath bezierPath];
      [p moveToPoint:NSMakePoint(num(cmd, @"x"), num(cmd, @"y"))];
      [p lineToPoint:NSMakePoint(num(cmd, @"x") + num(cmd, @"w"), num(cmd, @"y") + num(cmd, @"h"))];
      p.lineWidth = num(cmd, @"lw");
      [color(cmd[@"color"]) setStroke];
      [p stroke];
    }
    if ([kind isEqualToString:@"oval"]) {
      NSRect box = NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"));
      [color(cmd[@"color"]) setFill];
      [[NSBezierPath bezierPathWithOvalInRect:box] fill];
    }
    if ([kind isEqualToString:@"text"]) {
      NSRect box = NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"));
      NSFont *font = fontFor(cmd);
      NSMutableParagraphStyle *ps = [NSMutableParagraphStyle new];
      ps.alignment = NSTextAlignmentCenter;
      [cmd[@"s"] drawInRect:box withAttributes:@{
        NSFontAttributeName: font,
        NSForegroundColorAttributeName: color(cmd[@"color"]),
        NSParagraphStyleAttributeName: ps,
      }];
    }
  }
}
static int mods(NSEvent *e) {
  int m = 0;
  if (e.modifierFlags & NSEventModifierFlagCommand) m |= 1;
  if (e.modifierFlags & NSEventModifierFlagShift) m |= 2;
  if (e.modifierFlags & NSEventModifierFlagOption) m |= 4;
  if (e.modifierFlags & NSEventModifierFlagControl) m |= 8;
  return m;
}

- (BOOL)isFlipped { return YES; }
- (BOOL)acceptsFirstResponder { return YES; }
- (instancetype)initWithFrame:(NSRect)f {
  self = [super initWithFrame:f];
  if (self) {
    [self addTrackingArea:[[NSTrackingArea alloc]
      initWithRect:self.bounds
      options:NSTrackingMouseMoved | NSTrackingActiveAlways | NSTrackingInVisibleRect
      owner:self userInfo:nil]];
  }
  return self;
}
- (void)emitPoint:(NSEvent *)e kind:(NSString *)kind {
  NSPoint p = [self convertPoint:e.locationInWindow fromView:nil];
  emitJSON(@{ @"event": kind, @"x": @(p.x), @"y": @(p.y) });
}
- (void)emitKey:(NSEvent *)e kind:(NSString *)kind {
  emitJSON(@{ @"event": kind,
              @"key": e.charactersIgnoringModifiers ?: @"",
              @"code": @(e.keyCode),
              @"mods": @(mods(e)),
              @"repeat": @(e.ARepeat) });
}
- (void)mouseDown:(NSEvent *)e { [self emitPoint:e kind:@"mousedown"]; }
- (void)mouseUp:(NSEvent *)e { [self emitPoint:e kind:@"mouseup"]; }
- (void)mouseDragged:(NSEvent *)e { [self emitPoint:e kind:@"mousemove"]; }
- (void)mouseMoved:(NSEvent *)e { [self emitPoint:e kind:@"mousemove"]; }
- (void)rightMouseDown:(NSEvent *)e { [self emitPoint:e kind:@"rightdown"]; }
- (void)scrollWheel:(NSEvent *)e {
  NSPoint p = [self convertPoint:e.locationInWindow fromView:nil];
  double dx = e.hasPreciseScrollingDeltas ? e.scrollingDeltaX : e.scrollingDeltaX * 16.0;
  double dy = e.hasPreciseScrollingDeltas ? e.scrollingDeltaY : e.scrollingDeltaY * 16.0;
  emitJSON(@{ @"event": @"scroll", @"x": @(p.x), @"y": @(p.y), @"dx": @(dx), @"dy": @(dy) });
}
- (void)keyDown:(NSEvent *)e {
  [self emitKey:e kind:@"keydown"];
  [self interpretKeyEvents:@[e]];
}
// Minimal NSTextInputClient surface: committed text arrives as "insert",
// preedit (marked) text as "marked", editing selectors as "cmd".
- (void)insertText:(id)s {
  NSString *str = [s isKindOfClass:[NSAttributedString class]] ? [s string] : s;
  emitJSON(@{ @"event": @"insert", @"s": str });
}
- (void)setMarkedText:(id)s selectedRange:(NSRange)r replacementRange:(NSRange)rr {
  NSString *str = [s isKindOfClass:[NSAttributedString class]] ? [s string] : s;
  emitJSON(@{ @"event": @"marked", @"s": str });
}
- (void)unmarkText { emitJSON(@{ @"event": @"marked", @"s": @"" }); }
- (BOOL)hasMarkedText { return NO; }
- (NSRange)markedRange { return NSMakeRange(NSNotFound, 0); }
- (NSRange)selectedRange { return NSMakeRange(0, 0); }
- (NSArray *)validAttributesForMarkedText { return @[]; }
- (NSAttributedString *)attributedSubstringForProposedRange:(NSRange)r actualRange:(NSRangePointer)a { return nil; }
- (NSUInteger)characterIndexForPoint:(NSPoint)p { return 0; }
- (NSRect)firstRectForCharacterRange:(NSRange)r actualRange:(NSRangePointer)a { return NSZeroRect; }
- (void)doCommandBySelector:(SEL)sel {
  NSString *name = NSStringFromSelector(sel);
  if ([name hasSuffix:@":"]) name = [name substringToIndex:name.length - 1];
  emitJSON(@{ @"event": @"cmd", @"s": name });
}
- (void)keyUp:(NSEvent *)e { [self emitKey:e kind:@"keyup"]; }
- (void)flagsChanged:(NSEvent *)e {
  emitJSON(@{ @"event": @"flags", @"mods": @(mods(e)) });
}
- (void)emitGeometry {
  NSSize size = self.bounds.size;
  double scale = self.window ? self.window.backingScaleFactor : 1.0;
  emitJSON(@{ @"event": @"resize", @"w": @(size.width), @"h": @(size.height), @"scale": @(scale) });
}
- (void)setFrameSize:(NSSize)size {
  [super setFrameSize:size];
  [self emitGeometry];
  [self setNeedsDisplay:YES];
}
- (void)viewDidMoveToWindow {
  [super viewDidMoveToWindow];
  [self emitGeometry];
}
- (id)accessibilityHitTest:(NSPoint)p { return self; }
- (NSArray *)accessibilityChildren {
  NSMutableArray *out = [NSMutableArray array];
  int i = 0;
  for (NSDictionary *a in self.axList ?: @[]) {
    AxEl *el = [[AxEl alloc] init];
    el.idx = i++;
    el.accessibilityParent = self;
    el.accessibilityRole = a[@"role"] ?: @"AXGroup";
    el.accessibilityLabel = a[@"label"] ?: @"";
    el.accessibilityFrameInParentSpace =
      NSMakeRect(num(a, @"x"), num(a, @"y"), num(a, @"w"), num(a, @"h"));
    el.accessibilityFocused = [a[@"focused"] boolValue];
    [out addObject:el];
  }
  return out;
}
- (void)viewDidChangeBackingProperties {
  [super viewDidChangeBackingProperties];
  [self emitGeometry];
  [self setNeedsDisplay:YES];
}
@end

@interface MenuTarget : NSObject
@end
@implementation MenuTarget
- (void)menuFired:(NSMenuItem *)item {
  emitJSON(@{ @"event": @"menu", @"i": @(item.tag) });
}
@end

static MenuTarget *gMenuTarget;

static NSMenuItem *menuItemFor(NSDictionary *it) {
  if ([it[@"separator"] boolValue]) return [NSMenuItem separatorItem];
  // shortcut spec: "cmd+shift+k" — key is the last segment, lowercase.
  NSString *key = @"";
  NSUInteger mask = 0;
  NSString *sc = it[@"shortcut"];
  if (sc && sc.length) {
    NSArray *parts = [[sc lowercaseString] componentsSeparatedByString:@"+"];
    key = parts.lastObject;
    for (NSString *p in parts) {
      if ([p isEqualToString:@"cmd"]) mask |= NSEventModifierFlagCommand;
      if ([p isEqualToString:@"shift"]) mask |= NSEventModifierFlagShift;
      if ([p isEqualToString:@"alt"]) mask |= NSEventModifierFlagOption;
      if ([p isEqualToString:@"ctrl"]) mask |= NSEventModifierFlagControl;
    }
  }
  NSMenuItem *item = [[NSMenuItem alloc] initWithTitle:it[@"label"] action:@selector(menuFired:) keyEquivalent:key];
  item.keyEquivalentModifierMask = mask;
  item.target = gMenuTarget;
  item.tag = [it[@"i"] intValue];
  if (it[@"enabled"] != nil) item.enabled = [it[@"enabled"] boolValue];
  return item;
}

static void buildMenus(NSArray *menus, NSString *appName) {
  NSMenu *main = [NSMenu new];
  NSMenuItem *appItem = [NSMenuItem new];
  NSMenu *appMenu = [NSMenu new];
  NSMenuItem *quit = [[NSMenuItem alloc] initWithTitle:[@"Quit " stringByAppendingString:appName]
                                                action:@selector(terminate:) keyEquivalent:@"q"];
  quit.target = NSApp;
  [appMenu addItem:quit];
  appItem.submenu = appMenu;
  [main addItem:appItem];
  for (NSDictionary *m in menus) {
    NSMenuItem *top = [[NSMenuItem alloc] initWithTitle:m[@"title"] action:nil keyEquivalent:@""];
    NSMenu *sub = [[NSMenu alloc] initWithTitle:m[@"title"]];
    for (NSDictionary *it in m[@"items"]) [sub addItem:menuItemFor(it)];
    top.submenu = sub;
    [main addItem:top];
  }
  NSApp.mainMenu = main;
}

@interface Delegate : NSObject <NSWindowDelegate>
@end
@implementation Delegate
- (void)windowWillClose:(NSNotification *)note { [NSApp terminate:nil]; }
- (void)windowDidBecomeKey:(NSNotification *)note { emitJSON(@{ @"event": @"focus" }); }
- (void)windowDidResignKey:(NSNotification *)note { emitJSON(@{ @"event": @"blur" }); }
@end

// NSWindow.delegate is weak; keep it alive for the process.
static Delegate *gDelegate;

int main(int argc, const char *argv[]) {
  @autoreleasepool {
    NSString *title = argc > 1 ? [NSString stringWithUTF8String:argv[1]] : @"mytov";
    double w = argc > 2 ? atof(argv[2]) : 480;
    double h = argc > 3 ? atof(argv[3]) : 360;

    [NSApplication sharedApplication];
    [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];

    NSWindow *win = [[NSWindow alloc]
      initWithContentRect:NSMakeRect(0, 0, w, h)
      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
                NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable
      backing:NSBackingStoreBuffered
      defer:NO];
    win.title = title;
    gDelegate = [Delegate new];
    win.delegate = gDelegate;
    [win center];

    gView = [[ListView alloc] initWithFrame:win.contentView.bounds];
    gView.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
    [win.contentView addSubview:gView];

    // Read display lists off stdin on a background thread.
    [NSThread detachNewThreadWithBlock:^{
      char *line = NULL;
      size_t cap = 0;
      while (getline(&line, &cap, stdin) > 0) {
        NSData *d = [NSData dataWithBytes:line length:strlen(line)];
        NSDictionary *msg = [NSJSONSerialization JSONObjectWithData:d options:0 error:nil];
        NSArray *frame = msg[@"frame"];
        if (frame) {
          NSArray *damage = msg[@"damage"];
          NSArray *ax = msg[@"ax"];
          dispatch_async(dispatch_get_main_queue(), ^{
            gView.displayList = frame;
            if (ax) {
              gView.axList = ax;
              NSAccessibilityPostNotification(gView, NSAccessibilityLayoutChangedNotification);
            }
            if (damage) {
              for (NSDictionary *d in damage) {
                [gView setNeedsDisplayInRect:NSMakeRect(num(d, @"x"), num(d, @"y"), num(d, @"w"), num(d, @"h"))];
              }
            } else {
              [gView setNeedsDisplay:YES];
            }
          });
        }
        NSString *open = msg[@"open"];
        if (open) {
          NSURL *u = [NSURL URLWithString:open];
          if (u) dispatch_async(dispatch_get_main_queue(), ^{
            [[NSWorkspace sharedWorkspace] openURL:u];
          });
        }
        NSNumber *getClip = msg[@"getClipboard"];
        if (getClip) {
          NSString *str = [[NSPasteboard generalPasteboard] stringForType:NSPasteboardTypeString];
          emitJSON(@{ @"event": @"clipboard", @"s": str ?: @"" });
        }
        NSString *setClip = msg[@"setClipboard"];
        if (setClip) {
          [[NSPasteboard generalPasteboard] clearContents];
          [[NSPasteboard generalPasteboard] setString:setClip forType:NSPasteboardTypeString];
        }
        NSArray *menus = msg[@"menus"];
        if (menus) {
          dispatch_async(dispatch_get_main_queue(), ^{ buildMenus(menus, title); });
        }
        NSDictionary *cm = msg[@"contextMenu"];
        if (cm) {
          NSArray *items = cm[@"items"];
          dispatch_async(dispatch_get_main_queue(), ^{
            NSMenu *m = [NSMenu new];
            for (NSDictionary *it in items) [m addItem:menuItemFor(it)];
            NSPoint p = NSMakePoint(num(cm, @"x"), num(cm, @"y"));
            // NSMenu expects flipped-adjusted coords within the view.
            [m popUpMenuPositioningItem:nil atLocation:p inView:gView];
          });
        }
        NSDictionary *tray = msg[@"tray"];
        if (tray) {
          dispatch_async(dispatch_get_main_queue(), ^{
            static NSStatusItem *item;
            if (!item) item = [[NSStatusBar systemStatusBar] statusItemWithLength:NSVariableStatusItemLength];
            item.button.title = tray[@"title"] ?: @"";
            NSArray *items = tray[@"items"];
            if (items) {
              NSMenu *m = [NSMenu new];
              for (NSDictionary *it in items) [m addItem:menuItemFor(it)];
              item.menu = m;
            }
          });
        }
        NSDictionary *m = msg[@"measure"];
        if (m) {
          NSSize sz = [m[@"s"] sizeWithAttributes:@{NSFontAttributeName: fontFor(m)}];
          emitJSON(@{ @"event": @"measured",
                      @"id": m[@"id"],
                      @"w": @(ceil(sz.width)),
                      @"h": @(ceil(sz.height)) });
        }
      }
      // stdin closed: the Tov process is gone.
      dispatch_async(dispatch_get_main_queue(), ^{ [NSApp terminate:nil]; });
    }];

    const char *click = getenv("MYTOV_CLICK");
    if (click) {
      double cx = 0, cy = 0;
      sscanf(click, "%lf,%lf", &cx, &cy);
      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.7 * NSEC_PER_SEC)),
                     dispatch_get_main_queue(), ^{
        char buf[256];
        snprintf(buf, sizeof(buf), "{\\"event\\":\\"mousedown\\",\\"x\\":%g,\\"y\\":%g}", cx, cy);
        emit(buf);
        snprintf(buf, sizeof(buf), "{\\"event\\":\\"mouseup\\",\\"x\\":%g,\\"y\\":%g}", cx, cy);
        emit(buf);
      });
    }

    [win makeKeyAndOrderFront:nil];
    [win makeFirstResponder:gView];
    [NSApp activateIgnoringOtherApps:YES];
    // The Tov side may attach its line reader after the first setFrameSize;
    // re-announce geometry once the run loop is up.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{ [gView emitGeometry]; });
    [NSApp run];
  }
  return 0;
}
`

function helperPath(): string {
  const home = (process.env.HOME ?? process.env.USERPROFILE)!
  const dir = path.join(home, ".cache", "mytov")
  const src = path.join(dir, "mytov-window.m")
  const bin = path.join(dir, "mytov-window")
  const cached = existsSync(src) && try readFileSync(src, "utf8") === HELPER_SRC
  if (existsSync(bin) && cached) return bin
  try mkdirSync(dir, { recursive: true })
  try writeFileSync(src, HELPER_SRC)
  try execFileSync("clang", ["-fobjc-arc", "-O2", "-framework", "Cocoa", "-o", bin, src])
  return bin
}

// Rectangles the helper must repaint to go from `old` to `now`: the box of
// every command that changed, moved, appeared, or vanished. The lists are
// positionally stable for a stable tree shape, so index-wise diffing is
// exact; a length change damages the tail.
export function damageRects(old: Cmd[], now: Cmd[]): Box[] {
  let out: Box[] = []
  const n = Math.max(old.length, now.length)
  for (let i = 0; i < n; i += 1) {
    const a = i < old.length ? old[i] : undefined
    const b = i < now.length ? now[i] : undefined
    const same = a !== undefined && b !== undefined && JSON.stringify(a) === JSON.stringify(b)
    if (!same) {
      if (a !== undefined) out.push(cmdBox(a))
      if (b !== undefined) out.push(cmdBox(b))
    }
  }
  return out
}

export function cmdBox(c: Cmd): Box {
  if (c.kind === "popClip") return { x: 0, y: 0, w: 0, h: 0 }
  return { x: c.x, y: c.y, w: c.w, h: c.h }
}

// Topmost hit region at a point (later entries draw on top).
function inBox(x: f64, y: f64, b: Box): bool {
  return x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h
}

// Topmost hit region at a point (later entries draw on top). A region with
// a clip box only hits inside it — scrolled-out content can't be clicked.
export function hitAt(x: f64, y: f64, hits: Hit[]): int {
  for (let i = hits.length - 1; i >= 0; i -= 1) {
    const h = hits[i]!
    if (h.clip !== undefined && !inBox(x, y, h.clip!)) continue
    if (inBox(x, y, h.box)) return i
  }
  return -1
}

// --- windows ----------------------------------------------------------

// Event packets from the helper. `key` is charactersIgnoringModifiers,
// `code` the macOS keyCode; mods is a bitmask (cmd 1, shift 2, alt 4, ctrl 8).
type Ev = {
  event: string,
  x?: f64, y?: f64,
  w?: f64, h?: f64,
  dx?: f64, dy?: f64,
  id?: int, scale?: f64,
  key?: string, code?: int, mods?: int, repeat?: bool,
  s?: string,
  i?: int,
}

export const MOD_CMD = 1
export const MOD_SHIFT = 2
export const MOD_ALT = 4
export const MOD_CTRL = 8

const KEY_ENTER = 36
const KEY_SPACE = 49
const KEY_TAB = 48

let measureSeq = 0
const measureKeys: Map<int, string> = new Map()
const measureWaiters: Map<int, (s: Size) => void> = new Map()

let windows: Window[] = []
let keepalive = false
// Set by layout when a spinner is placed; renderPass marks the window
// "live" so the pump keeps re-rendering it.
let spinnerSeen = false
let tick = 0

// Call in a custom view's paint when it animates; its window then
// re-renders on every pump tick.
export function animating() {
  spinnerSeen = true
}

// The animation pump's counter: ~80ms per step while a window is live.
export function tickCount(): int {
  return tick
}

// Open a URL in the default browser (routed through any live helper).
export function openUrl(url: string) throws Error {
  const w = windows[0]
  if (w === undefined) return
  try w.stdin!.write(`{"open":${JSON.stringify(url)}}\n`)
}

// The window whose handler is running right now (set at dispatch entry).
let activeWindow: Window | undefined = undefined

// Asks the helper for the pasteboard string; arrives as a "clipboard"
// event routed to the focused region's text handler.
export function readClipboard(w?: Window) throws Error {
  const win = w ?? activeWindow ?? windows[0]
  if (win === undefined) return
  try win.stdin!.write(`{"getClipboard":1}\n`)
}

export function writeClipboard(s: string, w?: Window) throws Error {
  const win = w ?? activeWindow ?? windows[0]
  if (win === undefined) return
  try win.stdin!.write(`{"setClipboard":${JSON.stringify(s)}}\n`)
}

export type WindowOptions = { title?: string, width?: int, height?: int, view: () => View }

// One window per helper process: own NSWindow, own pipe, own hit state.
// The app exits when the last window closes.
export class Window {
  w = 480.0
  h = 360.0
  // Points, not pixels: every coordinate and text size is in points, and the
  // helper draws vectorially, so Retina output is automatic. scale is the
  // window's backing factor, kept for when a view needs pixel alignment.
  scale = 1.0
  hover = -1
  pressed = -1
  focus = -1
  key = false
  hits: Hit[] = []
  lastCmds: Cmd[] = []
  lastFrame = ""
  stdin: Js | undefined
  view: () => View
  live = false

  title = "mytov"

  constructor(opts: WindowOptions) {
    this.view = opts.view
    this.w = opts.width ?? 480
    this.h = opts.height ?? 360
    this.title = opts.title ?? "mytov"
  }

  open() throws Error | JsError {
    const child = try spawn(helperPath(), [this.title, `${this.w}`, `${this.h}`], {
      stdio: ["pipe", "pipe", "inherit"],
    })
    this.stdin = child.stdin
    const rl = try createInterface({ input: child.stdout })
    const debug = process.env.MYTOV_DEBUG !== undefined
    try rl.on("line", (line: Js) => {
      if (debug) console.log(`window> ${line as string}`)
      try {
        const ev = try JSON.parse(line as string) as Ev
        if (ev.event === "measured") {
          resolveMeasure(ev)
        } else if (this.dispatch(ev)) {
          this.render()
        }
      } catch (e) {
        console.error(`mytov: ${e.message}`)
      }
    })
    try child.on("exit", () => {
      windows = windows.filter((w) => w !== this)
      if (windows.length === 0) process.exit(0)
    })
    this.render()
    if (!keepalive) {
      // The event loop must stay alive for the helpers' stdout lines (and JS
      // callbacks generally) to be delivered; there is no server to hold it.
      // The tick also drives animated widgets (a window is live while its
      // last render placed one).
      keepalive = true
      setInterval(() => {
        tick += 1
        for (const w of windows) {
          if (w.live) w.render()
        }
      }, 80)
    }
  }

  hitAt(x: f64, y: f64): int {
    return hitAt(x, y, this.hits)
  }

  nextFocusable(from: int, dir: int): int {
    const n = this.hits.length
    for (let step = 1; step <= n; step += 1) {
      const i = ((from + dir * step) % n + n) % n
      if (this.hits[i]!.on.focusable === true) return i
    }
    return -1
  }

  // Apply one helper event to this window's state. Returns true when a
  // re-render is warranted.
  dispatch(ev: Ev): bool {
    activeWindow = this
    const pt = ev.x !== undefined && ev.y !== undefined
    switch (ev.event) {
      case "mousedown": {
        this.pressed = pt ? this.hitAt(ev.x!, ev.y!) : -1
        if (this.pressed >= 0) {
          const h = this.hits[this.pressed]!.on
          if (h.focusable === true) this.focus = this.pressed
          const press = h.press
          if (press !== undefined) press(ev.x!, ev.y!)
        }
        return true
      }
      case "rightdown": {
        if (!pt) return false
        for (let i = this.hits.length - 1; i >= 0; i -= 1) {
          const h = this.hits[i]!
          if (h.clip !== undefined && !inBox(ev.x!, ev.y!, h.clip!)) continue
          const rc = h.on.rightClick
          if (rc !== undefined && inBox(ev.x!, ev.y!, h.box)) {
            rc(ev.x!, ev.y!)
            return true
          }
        }
        return false
      }
      case "mouseup": {
        const was = this.pressed
        this.pressed = -1
        if (was >= 0 && pt && this.hitAt(ev.x!, ev.y!) === was) {
          const click = this.hits[was]!.on.click
          if (click !== undefined) click()
        }
        return true
      }
      case "mousemove": {
        if (this.pressed >= 0 && this.pressed < this.hits.length) {
          const drag = this.hits[this.pressed]!.on.drag
          if (drag !== undefined && pt) {
            drag(ev.x!, ev.y!)
            return true
          }
        }
        const i = pt ? this.hitAt(ev.x!, ev.y!) : -1
        if (i === this.hover) return false
        if (this.hover >= 0) {
          const h = this.hits[this.hover]!.on.hover
          if (h !== undefined) h(false)
        }
        this.hover = i
        if (i >= 0) {
          const h = this.hits[i]!.on.hover
          if (h !== undefined) h(true)
        }
        return true
      }
      case "scroll": {
        if (!pt) return false
        for (let i = this.hits.length - 1; i >= 0; i -= 1) {
          const h = this.hits[i]!
          const b = h.box
          if (h.clip !== undefined && !inBox(ev.x!, ev.y!, h.clip!)) continue
          const scroll = h.on.scroll
          if (scroll !== undefined && inBox(ev.x!, ev.y!, b)) {
            scroll(ev.dx ?? 0, ev.dy ?? 0)
            return true
          }
        }
        return false
      }
      case "keydown": {
        const ke: KeyEv = { code: ev.code ?? 0, key: ev.key ?? "", mods: ev.mods ?? 0, repeat: ev.repeat ?? false }
        if (ke.code === KEY_TAB) {
          this.focus = this.nextFocusable(this.focus, (ke.mods & MOD_SHIFT) !== 0 ? -1 : 1)
          return true
        }
        const focused = this.focus >= 0 && this.focus < this.hits.length ? this.hits[this.focus] : undefined
        const keyHandler = focused?.on?.key
        if (keyHandler !== undefined) {
          keyHandler(ke)
          return true
        }
        if ((ke.code === KEY_ENTER || ke.code === KEY_SPACE) && focused !== undefined) {
          const click = focused.on.click
          if (click !== undefined) click()
          return true
        }
        return false
      }
      case "keyup": {
        const focused = this.focus >= 0 && this.focus < this.hits.length ? this.hits[this.focus] : undefined
        const keyHandler = focused?.on?.key
        if (keyHandler !== undefined) {
          keyHandler({ code: ev.code ?? 0, key: ev.key ?? "", mods: ev.mods ?? 0, repeat: ev.repeat ?? false })
          return true
        }
        return false
      }
      case "flags":
        return false
      case "insert":
      case "cmd":
      case "marked":
      case "clipboard": {
        const focused = this.focus >= 0 && this.focus < this.hits.length ? this.hits[this.focus] : undefined
        const handler = focused?.on?.text
        if (handler !== undefined) {
          handler(ev.event, ev.s ?? "")
          return true
        }
        return false
      }
      case "menu": {
        const i = ev.i ?? -1
        const action = menuActions.get(i)
        if (action !== undefined) action()
        return false
      }
      case "axpress": {
        const i = ev.i ?? -1
        if (i >= 0 && i < this.hits.length) {
          const click = this.hits[i]!.on.click
          if (click !== undefined) click()
        }
        return false
      }
      case "focus":
        this.key = true
        return false
      case "blur":
        this.key = false
        return true
      case "resize":
        this.w = ev.w ?? this.w
        this.h = ev.h ?? this.h
        this.scale = ev.scale ?? this.scale
        return true
    }
    return false
  }

  // Re-render after state may have changed. Detached task: measure
  // round-trips make it async; channel errors are logged (a dead helper
  // means the process is on its way out anyway).
  render() {
    this.renderFrame()
  }

  async renderFrame() {
    try {
      await this.renderPass()
    } catch (e) {
      console.error(`mytov: ${e.message}`)
    }
  }

  // Issues measure requests for every unmeasured text command; returns true
  // if any were sent.
  measureCmdTexts(cmds: Cmd[]): bool {
    let any = false
    for (const c of cmds) {
      if (c.kind === "text") {
        const key = textKey({ s: c.s, size: c.size, bold: c.bold })
                if (!textCache.has(key) && !inflight.has(key)) {
          try {
            any = this.queueMeasure({ s: c.s, size: c.size, bold: c.bold }) || any
          } catch (e) {
            console.error(`mytov measure: ${e.message}`)
          }
        }
      }
    }
    return any
  }

  queueMeasure(r: TextRun): bool throws JsError {
    const key = textKey(r)
    if (textCache.has(key) || inflight.has(key)) return false
    const id = measureSeq
    measureSeq += 1
    measureKeys.set(id, key)
    inflight.add(key)
    this.waits.push(new Promise<Size>((resolve) => measureWaiters.set(id, resolve)))
    try this.stdin!.write(`{"measure":{"id":${id},"s":${JSON.stringify(r.s)},"size":${r.size},"bold":${r.bold}}}\n`)
    return true
  }

  waits: Promise<Size>[] = []

  pendingWaits(): Promise<Size>[] {
    const w = this.waits
    this.waits = []
    return w
  }

  async renderPass() throws Error {
    const v = this.view()
    let runs: TextRun[] = []
    let seen: Set<string> = new Set()
    collectRuns(v, &runs, &seen)
    for (const r of runs) {
      try this.queueMeasure(r)
    }
    try await Promise.all(this.pendingWaits())
    spinnerSeen = false
    let l = layout(v, this.w, this.h, { hover: this.hover, pressed: this.pressed, focus: this.key ? this.focus : -1 })
    // Views generated during layout (e.g. visible list rows) can carry text
    // runs collectRuns never saw; measure those and lay out once more.
    if (this.measureCmdTexts(l.frame.frame)) {
      try await Promise.all(this.pendingWaits())
      spinnerSeen = false
      l = layout(v, this.w, this.h, { hover: this.hover, pressed: this.pressed, focus: this.key ? this.focus : -1 })
    }
    this.live = spinnerSeen
    this.hits = l.hits
    const json = JSON.stringify(l.frame)
    if (json !== this.lastFrame) {
      const damage = damageRects(this.lastCmds, l.frame.frame)
      this.lastCmds = l.frame.frame
      this.lastFrame = json
      // AX elements mirror the hit list: ax entries carry the hit index so
      // axpress routes back, and the helper builds an element per entry.
      let axs: { i: int, x: f64, y: f64, w: f64, h: f64, role: string, label: string, focused: bool }[] = []
      for (let i = 0; i < l.hits.length; i += 1) {
        const h = l.hits[i]!
        const a = h.on.ax
        if (a !== undefined) {
          axs.push({ i, x: h.box.x, y: h.box.y, w: h.box.w, h: h.box.h, role: a.role, label: a.label, focused: i === this.focus })
        }
      }
      try this.stdin!.write(JSON.stringify({ frame: l.frame.frame, damage, ax: axs }) + "\n")
    }
  }
}

function resolveMeasure(ev: Ev) {
  if (ev.id === undefined || ev.w === undefined || ev.h === undefined) return
  const key = measureKeys.get(ev.id)
  if (key === undefined) return
  const size = { w: ev.w, h: ev.h }
  textCache.set(key, size)
  inflight.delete(key)
  const waiter = measureWaiters.get(ev.id)
  if (waiter !== undefined) {
    measureWaiters.delete(ev.id)
    waiter(size)
  }
}

// Open a window. `view` is re-rendered after every input event; the frame
// is sent only when it changed, with damage rects for partial repaint.
export function newWindow(opts: WindowOptions): Window throws Error | JsError {
  const win = new Window(opts)
  try win.open()
  windows.push(win)
  return win
}

export function run(opts: WindowOptions) throws Error | JsError {
  try newWindow(opts)
}

// --- menus --------------------------------------------------------------

export type MenuItem = {
  label: string,
  // "cmd+shift+k" style; cmd/shift/alt/ctrl.
  shortcut?: string,
  enabled?: bool,
  separator?: bool,
  action?: () => void,
}

export type MenuSpec = { title: string, items: MenuItem[] }

const menuActions: Map<int, () => void> = new Map()
let menuSeq = 0

// Serializes menus, registering each action; shared by setMenus/showMenu.
function menuPayload(items: MenuItem[]): { label: string, shortcut: string, enabled: bool, separator: bool, i: int }[] {
  let out: { label: string, shortcut: string, enabled: bool, separator: bool, i: int }[] = []
  for (const it of items) {
    let i = -1
    if (it.action !== undefined) {
      i = menuSeq
      menuSeq += 1
      menuActions.set(i, it.action!)
    }
    out.push({ label: it.label, shortcut: it.shortcut ?? "", enabled: it.enabled ?? true, separator: it.separator ?? false, i })
  }
  return out
}

// Replaces the app menu bar in every window's helper (menus are app-global;
// every helper gets the same bar so it stays consistent when focus moves
// between windows).
export function setMenus(menus: MenuSpec[]) throws Error {
  let out: { title: string, items: { label: string, shortcut: string, enabled: bool, separator: bool, i: int }[] }[] = []
  for (const m of menus) out.push({ title: m.title, items: menuPayload(m.items) })
  const msg = `{"menus":${JSON.stringify(out)}}\n`
  for (const w of windows) try w.stdin!.write(msg)
}

// Creates or updates the status-bar item; items become its click menu.
export function setTray(opts: { title: string, items?: MenuItem[] }) throws Error {
  const w = windows[0]
  if (w === undefined) return
  const items = opts.items === undefined ? "null" : JSON.stringify(menuPayload(opts.items))
  try w.stdin!.write(`{"tray":{"title":${JSON.stringify(opts.title)},"items":${items}}}\n`)
}

// Pops a context menu at a view-space point in a window (the app's
// right-click handler is the usual caller).
export function showMenu(items: MenuItem[], x: f64, y: f64, w?: Window) throws Error {
  const win = w ?? activeWindow ?? windows[0]
  if (win === undefined) return
  try win.stdin!.write(`{"contextMenu":{"x":${x},"y":${y},"items":${JSON.stringify(menuPayload(items))}}}\n`)
}
