import { button, column, newWindow, pad, run, spacer, text } from "../../src/mytov"
import type { View } from "../../src/mytov"

class Counter {
  n = 0
}

const counter = new Counter()

function view(): View {
  return column(
    [
      text(`${counter.n}`, { size: 40, bold: true }),
      button("Increment", () => {
        counter.n += 1
        console.log(`count: ${counter.n}`)
      }),
    ],
    12,
  )
}

function about(): View {
  return pad(
    24,
    column(
      [
        text("mytov", { size: 24, bold: true }),
        text("native UI from Tov"),
        spacer(),
        text("second window", { color: "#666666" }),
      ],
      8,
    ),
  )
}

try run({ title: "Counter", width: 480, height: 360, view })
try newWindow({ title: "About", width: 300, height: 220, view: about })
