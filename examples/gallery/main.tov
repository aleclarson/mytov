import { ScrollState, column, list, pad, row, run, spacer, split, SplitState, text } from "../../src/mytov"
import type { View } from "../../src/mytov"
import { Field, badge, checkbox, input, link, meter, numberInput, progress, radio, searchField, segmented, slider, spinner, stepper, textarea, toggle } from "../../src/widgets"

class State {
  wifi = true
  dark = false
  choice = 0
  volume = 0.4
  seg = 0
  loading = true
  name = new Field()
  age = new Field()
  notes = new Field()
  q = new Field()
  listScroll = new ScrollState()
  splitPos = new SplitState()
}

const s = new State()

function labeled(labelText: string, child: View): View {
  return row([text(labelText, { color: "#6e6e73" }), spacer(), child], 12)
}

function view(): View {
  return pad(
    24,
    column(
      [
        row([text("mytov widgets", { size: 22, bold: true }), spacer(), badge("beta", "#ff9500")]),
        labeled("Wi-Fi", toggle(s.wifi, (v) => { s.wifi = v })),
        labeled("Notifications", checkbox(s.dark, "Enabled", (v) => { s.dark = v })),
        labeled("Pick one", column([radio(s.choice === 0, "First", () => { s.choice = 0 }), radio(s.choice === 1, "Second", () => { s.choice = 1 })], 6)),
        labeled("Volume", slider(s.volume, (v) => { s.volume = v })),
        segmented(["Day", "Week", "Month"], s.seg, (i) => { s.seg = i }),
        labeled("Progress", progress(s.volume)),
        labeled("Load", meter(s.volume)),
        labeled("Name", input(s.name, { placeholder: "Your name" })),
        labeled("Age", row([numberInput(s.age, (d) => { s.age.s = `${(parseInt(s.age.s) ?? 0) + d}` }), stepper((d) => { s.age.s = `${(parseInt(s.age.s) ?? 0) + d}` })], 4)),
        labeled("Notes", textarea(s.notes, 60)),
        labeled("Search", searchField(s.q)),
        row([spinner(20), text("loading…", { color: "#6e6e73" })], 8),
        link("github.com/aleclarson/mytov", "https://github.com/aleclarson/mytov"),
        list(200, 24, (i) => text(`row ${i}`, { color: i % 2 === 0 ? "#111111" : "#555555" }), s.listScroll),
      ],
      12,
    ),
  )
}

try run({ title: "Widgets", width: 440, height: 420, view })
