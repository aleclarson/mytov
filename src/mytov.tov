import { createInterface } from "node:readline"
import { execFileSync, spawn } from "node:child_process"
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs"
import * as path from "node:path"

// mytov draws UI itself, like mygo's package ui — no webview. Tov has no
// FFI, so a frame becomes a display list: JSON lines on the stdin of a
// small helper process that owns an NSWindow and paints the list with
// AppKit/CoreText. Input comes back on its stdout the same way.

// --- views ------------------------------------------------------------

export type KeyEv = { code: int, key: string, mods: int, repeat: bool }

// Event handlers a region of the layout can carry. `focusable` puts the
// region in the Tab chain; a focused region gets key events first.
export type Handlers = {
  click?: () => void,
  hover?: (hovering: bool) => void,
  scroll?: (dx: f64, dy: f64) => void,
  key?: (e: KeyEv) => void,
  focusable?: bool,
}

export type View =
  | { kind: "text", s: string, size: f64, bold: bool, color: string }
  | { kind: "button", title: string, onClick: () => void }
  | { kind: "events", child: View, on: Handlers }
  | { kind: "column", gap: f64, children: View[] }
  | { kind: "row", gap: f64, children: View[] }
  | { kind: "pad", inset: f64, child: View }
  | { kind: "spacer" }

export type TextOpts = { size?: f64, bold?: bool, color?: string }

export function text(s: string, opts?: TextOpts): View {
  return { kind: "text", s, size: opts?.size ?? 15, bold: opts?.bold ?? false, color: opts?.color ?? "#111111" }
}

export function button(title: string, onClick: () => void): View {
  return { kind: "button", title, onClick }
}

export function column(children: View[], gap?: f64): View {
  return { kind: "column", gap: gap ?? 0, children }
}

export function row(children: View[], gap?: f64): View {
  return { kind: "row", gap: gap ?? 0, children }
}

export function pad(inset: f64, child: View): View {
  return { kind: "pad", inset, child }
}

export function spacer(): View {
  return { kind: "spacer" }
}

// Attach event handlers to a view's region. Handlers on an inner view win
// over an `on` wrapper's where they overlap (inner is more specific).
export function on(child: View, handlers: Handlers): View {
  return { kind: "events", child, on: handlers }
}

// --- layout ------------------------------------------------------------

export type Size = { w: f64, h: f64 }
export type Box = { x: f64, y: f64, w: f64, h: f64 }
export type Hit = { box: Box, on: Handlers }

export type Cmd =
  | { kind: "rect", x: f64, y: f64, w: f64, h: f64, color: string, radius: f64, stroke: string, lw: f64 }
  | { kind: "text", x: f64, y: f64, w: f64, h: f64, s: string, size: f64, color: string, bold: bool }
export type Frame = { frame: Cmd[] }

// Text metrics. The render pass pre-measures every run through the helper
// (CoreText) and caches by key; the estimate is the fallback for callers
// that never warmed the cache, like tests.
const textCache: Map<string, Size> = new Map()
const inflight: Set<string> = new Set()

type TextRun = { s: string, size: f64, bold: bool }

function textKey(r: TextRun): string {
  return `${r.s}${r.size}${r.bold}`
}

function textSize(s: string, size: f64, bold: bool): Size {
  return textCache.get(`${s}${size}${bold}`) ?? { w: s.chars().length * size * (bold ? 0.6 : 0.55), h: size * 1.35 }
}

function textW(s: string, size: f64, bold: bool): f64 {
  return textSize(s, size, bold).w
}

function addRun(inout out: TextRun[], inout seen: Set<string>, s: string, size: f64, bold: bool) {
  const k = textKey({ s, size, bold })
  if (!seen.has(k) && !textCache.has(k) && !inflight.has(k)) {
    seen.add(k)
    out.push({ s, size, bold })
  }
}

// Every text run a view tree will draw, deduplicated by cache key.
function collectRuns(v: View, inout out: TextRun[], inout seen: Set<string>) {
  switch (v.kind) {
    case "text":
      addRun(&out, &seen, v.s, v.size, v.bold)
      break
    case "button":
      addRun(&out, &seen, v.title, 15.0, true)
      break
    case "pad":
      collectRuns(v.child, &out, &seen)
      break
    case "events":
      collectRuns(v.child, &out, &seen)
      break
    case "column":
    case "row":
      for (const c of v.children) collectRuns(c, &out, &seen)
      break
    case "spacer":
      break
  }
}

export function measure(v: View): Size {
  switch (v.kind) {
    case "text":
      return { w: textW(v.s, v.size, v.bold), h: v.size * 1.35 }
    case "button":
      return { w: textW(v.title, 15.0, true) + 32, h: 30.0 }
    case "spacer":
      return { w: 0, h: 0 }
    case "pad": {
      const s = measure(v.child)
      return { w: s.w + v.inset * 2, h: s.h + v.inset * 2 }
    }
    case "events":
      return measure(v.child)
    case "column": {
      let w = 0
      let h = v.gap * (v.children.length - 1)
      for (const c of v.children) {
        const s = measure(c)
        if (s.w > w) w = s.w
        h += s.h
      }
      return { w, h }
    }
    case "row": {
      let w = v.gap * (v.children.length - 1)
      let h = 0
      for (const c of v.children) {
        const s = measure(c)
        w += s.w
        if (s.h > h) h = s.h
      }
      return { w, h }
    }
  }
}

// Indexes into the hit list of the live window's hovered / pressed /
// focused region; -1 means none. Hit index stands in for view identity:
// trees are rebuilt every render, so state is stable only while the tree
// keeps the same shape.
export type Styles = { hover: int, pressed: int, focus: int }

const NO_HIT: Styles = { hover: -1, pressed: -1, focus: -1 }

// Lays `v` out inside `box`. Rows and columns center their stack on the
// main axis and each child on the cross axis; spacers split leftover
// space evenly.
export function place(v: View, box: Box, inout cmds: Cmd[], inout hits: Hit[], st?: Styles) {
  const style = st ?? NO_HIT
  switch (v.kind) {
    case "text":
      cmds.push({ kind: "text", x: box.x, y: box.y, w: box.w, h: box.h, s: v.s, size: v.size, color: v.color, bold: v.bold })
      break
    case "button": {
      const idx = hits.length
      const color = style.pressed === idx ? "#045cc4" : style.hover === idx ? "#1a86ff" : "#0a7aff"
      cmds.push({ kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color, radius: 6.0, stroke: "", lw: 0.0 })
      if (style.focus === idx) {
        cmds.push({ kind: "rect", x: box.x - 2.5, y: box.y - 2.5, w: box.w + 5.0, h: box.h + 5.0, color: "", radius: 8.0, stroke: "#6bb3ff", lw: 2.0 })
      }
      const th = textSize(v.title, 15.0, true).h
      cmds.push({ kind: "text", x: box.x, y: box.y + (box.h - th) / 2, w: box.w, h: th, s: v.title, size: 15.0, color: "#ffffff", bold: true })
      hits.push({ box, on: { click: v.onClick, focusable: true } })
      break
    }
    case "events":
      // Register the wrapper's region before placing the child so the
      // child's own regions come later in the list and win hit-testing.
      hits.push({ box, on: v.on })
      place(v.child, box, &cmds, &hits, st)
      break
    case "pad":
      place(v.child, { x: box.x + v.inset, y: box.y + v.inset, w: box.w - v.inset * 2, h: box.h - v.inset * 2 }, &cmds, &hits, st)
      break
    case "spacer":
      break
    case "column": {
      const sizes = v.children.map(measure)
      let fixed = v.gap * (v.children.length - 1)
      let spacers = 0
      let j = 0
      for (const c of v.children) {
        fixed += sizes[j]!.h
        if (c.kind === "spacer") spacers += 1
        j += 1
      }
      const extra = Math.max(0, box.h - fixed)
      const perSpacer = spacers > 0 ? extra / spacers : 0
      let y = box.y + (spacers > 0 ? 0 : extra / 2)
      let i = 0
      for (const c of v.children) {
        const s = sizes[i]!
        const h = c.kind === "spacer" ? perSpacer : s.h
        const w = Math.min(s.w, box.w)
        place(c, { x: box.x + (box.w - w) / 2, y, w, h }, &cmds, &hits, st)
        y += h + v.gap
        i += 1
      }
      break
    }
    case "row": {
      const sizes = v.children.map(measure)
      let fixed = v.gap * (v.children.length - 1)
      let spacers = 0
      let j = 0
      for (const c of v.children) {
        fixed += sizes[j]!.w
        if (c.kind === "spacer") spacers += 1
        j += 1
      }
      const extra = Math.max(0, box.w - fixed)
      const perSpacer = spacers > 0 ? extra / spacers : 0
      let x = box.x + (spacers > 0 ? 0 : extra / 2)
      let i = 0
      for (const c of v.children) {
        const s = sizes[i]!
        const w = c.kind === "spacer" ? perSpacer : s.w
        const h = Math.min(s.h, box.h)
        place(c, { x, y: box.y + (box.h - h) / 2, w, h }, &cmds, &hits, st)
        x += w + v.gap
        i += 1
      }
      break
    }
  }
}

export function layout(v: View, w: f64, h: f64, st?: Styles): { frame: Frame, hits: Hit[] } {
  let cmds: Cmd[] = []
  let hits: Hit[] = []
  place(v, { x: 0, y: 0, w, h }, &cmds, &hits, st)
  return { frame: { frame: cmds }, hits }
}

// --- window shim -------------------------------------------------------
//
// argv: <title> <width> <height>
// stdin:  {"frame":[cmd,...]} one JSON object per line; cmd is
//         {"kind":"rect",x,y,w,h,color,radius} or {"kind":"text",x,y,w,h,s,size,color,bold}
// stdout: {"event":"mousedown","x":..,"y":..} / {"event":"resize","w":..,"h":..}
// The view is flipped, so all coordinates are top-left origin.
// env MYTOV_CLICK="x,y" posts a synthetic mousedown ~0.7s after launch.

const HELPER_SRC = `#import <Cocoa/Cocoa.h>

static void emit(const char *s) {
  fputs(s, stdout);
  fputc('\\n', stdout);
  fflush(stdout);
}

static void emitJSON(NSDictionary *d) {
  NSData *data = [NSJSONSerialization dataWithJSONObject:d options:0 error:nil];
  fwrite(data.bytes, 1, data.length, stdout);
  fputc('\\n', stdout);
  fflush(stdout);
}

static NSFont *fontFor(NSDictionary *d) {
  double size = [d[@"size"] doubleValue];
  return [d[@"bold"] boolValue] ? [NSFont boldSystemFontOfSize:size]
                               : [NSFont systemFontOfSize:size];
}

static NSColor *color(NSString *hex) {
  unsigned r = 0, g = 0, b = 0;
  const char *s = hex.UTF8String;
  if (s[0] == '#') s++;
  sscanf(s, "%02x%02x%02x", &r, &g, &b);
  return [NSColor colorWithSRGBRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:1];
}

static double num(NSDictionary *d, NSString *k) { return [d[k] doubleValue]; }

@interface ListView : NSView
@property(nonatomic, strong) NSArray *displayList;
@end

static ListView *gView;

@implementation ListView
- (void)drawRect:(NSRect)dirty {
  [[NSColor whiteColor] setFill];
  NSRectFill(dirty);
  for (NSDictionary *cmd in self.displayList) {
    NSString *kind = cmd[@"kind"];
    if ([kind isEqualToString:@"rect"]) {
      NSRect box = NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"));
      double rad = num(cmd, @"radius");
      NSBezierPath *path = rad > 0 ? [NSBezierPath bezierPathWithRoundedRect:box xRadius:rad yRadius:rad]
                                   : [NSBezierPath bezierPathWithRect:box];
      NSString *fill = cmd[@"color"];
      if (fill.length > 0) { [color(fill) setFill]; [path fill]; }
      NSString *stroke = cmd[@"stroke"];
      if (stroke.length > 0) {
        [color(stroke) setStroke];
        path.lineWidth = num(cmd, @"lw") > 0 ? num(cmd, @"lw") : 1.0;
        [path stroke];
      }
    }
    if ([kind isEqualToString:@"text"]) {
      NSRect box = NSMakeRect(num(cmd, @"x"), num(cmd, @"y"), num(cmd, @"w"), num(cmd, @"h"));
      NSFont *font = fontFor(cmd);
      NSMutableParagraphStyle *ps = [NSMutableParagraphStyle new];
      ps.alignment = NSTextAlignmentCenter;
      [cmd[@"s"] drawInRect:box withAttributes:@{
        NSFontAttributeName: font,
        NSForegroundColorAttributeName: color(cmd[@"color"]),
        NSParagraphStyleAttributeName: ps,
      }];
    }
  }
}
static int mods(NSEvent *e) {
  int m = 0;
  if (e.modifierFlags & NSEventModifierFlagCommand) m |= 1;
  if (e.modifierFlags & NSEventModifierFlagShift) m |= 2;
  if (e.modifierFlags & NSEventModifierFlagOption) m |= 4;
  if (e.modifierFlags & NSEventModifierFlagControl) m |= 8;
  return m;
}

- (BOOL)isFlipped { return YES; }
- (BOOL)acceptsFirstResponder { return YES; }
- (instancetype)initWithFrame:(NSRect)f {
  self = [super initWithFrame:f];
  if (self) {
    [self addTrackingArea:[[NSTrackingArea alloc]
      initWithRect:self.bounds
      options:NSTrackingMouseMoved | NSTrackingActiveAlways | NSTrackingInVisibleRect
      owner:self userInfo:nil]];
  }
  return self;
}
- (void)emitPoint:(NSEvent *)e kind:(NSString *)kind {
  NSPoint p = [self convertPoint:e.locationInWindow fromView:nil];
  emitJSON(@{ @"event": kind, @"x": @(p.x), @"y": @(p.y) });
}
- (void)emitKey:(NSEvent *)e kind:(NSString *)kind {
  emitJSON(@{ @"event": kind,
              @"key": e.charactersIgnoringModifiers ?: @"",
              @"code": @(e.keyCode),
              @"mods": @(mods(e)),
              @"repeat": @(e.ARepeat) });
}
- (void)mouseDown:(NSEvent *)e { [self emitPoint:e kind:@"mousedown"]; }
- (void)mouseUp:(NSEvent *)e { [self emitPoint:e kind:@"mouseup"]; }
- (void)mouseDragged:(NSEvent *)e { [self emitPoint:e kind:@"mousemove"]; }
- (void)mouseMoved:(NSEvent *)e { [self emitPoint:e kind:@"mousemove"]; }
- (void)rightMouseDown:(NSEvent *)e { [self emitPoint:e kind:@"rightdown"]; }
- (void)scrollWheel:(NSEvent *)e {
  NSPoint p = [self convertPoint:e.locationInWindow fromView:nil];
  double dx = e.hasPreciseScrollingDeltas ? e.scrollingDeltaX : e.scrollingDeltaX * 16.0;
  double dy = e.hasPreciseScrollingDeltas ? e.scrollingDeltaY : e.scrollingDeltaY * 16.0;
  emitJSON(@{ @"event": @"scroll", @"x": @(p.x), @"y": @(p.y), @"dx": @(dx), @"dy": @(dy) });
}
- (void)keyDown:(NSEvent *)e { [self emitKey:e kind:@"keydown"]; }
- (void)keyUp:(NSEvent *)e { [self emitKey:e kind:@"keyup"]; }
- (void)flagsChanged:(NSEvent *)e {
  emitJSON(@{ @"event": @"flags", @"mods": @(mods(e)) });
}
- (void)emitGeometry {
  NSSize size = self.bounds.size;
  double scale = self.window ? self.window.backingScaleFactor : 1.0;
  emitJSON(@{ @"event": @"resize", @"w": @(size.width), @"h": @(size.height), @"scale": @(scale) });
}
- (void)setFrameSize:(NSSize)size {
  [super setFrameSize:size];
  [self emitGeometry];
  [self setNeedsDisplay:YES];
}
- (void)viewDidMoveToWindow {
  [super viewDidMoveToWindow];
  [self emitGeometry];
}
- (void)viewDidChangeBackingProperties {
  [super viewDidChangeBackingProperties];
  [self emitGeometry];
  [self setNeedsDisplay:YES];
}
@end

@interface Delegate : NSObject <NSWindowDelegate>
@end
@implementation Delegate
- (void)windowWillClose:(NSNotification *)note { [NSApp terminate:nil]; }
- (void)windowDidBecomeKey:(NSNotification *)note { emitJSON(@{ @"event": @"focus" }); }
- (void)windowDidResignKey:(NSNotification *)note { emitJSON(@{ @"event": @"blur" }); }
@end

// NSWindow.delegate is weak; keep it alive for the process.
static Delegate *gDelegate;

int main(int argc, const char *argv[]) {
  @autoreleasepool {
    NSString *title = argc > 1 ? [NSString stringWithUTF8String:argv[1]] : @"mytov";
    double w = argc > 2 ? atof(argv[2]) : 480;
    double h = argc > 3 ? atof(argv[3]) : 360;

    [NSApplication sharedApplication];
    [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];

    NSWindow *win = [[NSWindow alloc]
      initWithContentRect:NSMakeRect(0, 0, w, h)
      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
                NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable
      backing:NSBackingStoreBuffered
      defer:NO];
    win.title = title;
    gDelegate = [Delegate new];
    win.delegate = gDelegate;
    [win center];

    gView = [[ListView alloc] initWithFrame:win.contentView.bounds];
    gView.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
    [win.contentView addSubview:gView];

    // Read display lists off stdin on a background thread.
    [NSThread detachNewThreadWithBlock:^{
      char *line = NULL;
      size_t cap = 0;
      while (getline(&line, &cap, stdin) > 0) {
        NSData *d = [NSData dataWithBytes:line length:strlen(line)];
        NSDictionary *msg = [NSJSONSerialization JSONObjectWithData:d options:0 error:nil];
        NSArray *frame = msg[@"frame"];
        if (frame) {
          NSArray *damage = msg[@"damage"];
          dispatch_async(dispatch_get_main_queue(), ^{
            gView.displayList = frame;
            if (damage) {
              for (NSDictionary *d in damage) {
                [gView setNeedsDisplayInRect:NSMakeRect(num(d, @"x"), num(d, @"y"), num(d, @"w"), num(d, @"h"))];
              }
            } else {
              [gView setNeedsDisplay:YES];
            }
          });
        }
        NSDictionary *m = msg[@"measure"];
        if (m) {
          NSSize sz = [m[@"s"] sizeWithAttributes:@{NSFontAttributeName: fontFor(m)}];
          emitJSON(@{ @"event": @"measured",
                      @"id": m[@"id"],
                      @"w": @(ceil(sz.width)),
                      @"h": @(ceil(sz.height)) });
        }
      }
      // stdin closed: the Tov process is gone.
      dispatch_async(dispatch_get_main_queue(), ^{ [NSApp terminate:nil]; });
    }];

    const char *click = getenv("MYTOV_CLICK");
    if (click) {
      double cx = 0, cy = 0;
      sscanf(click, "%lf,%lf", &cx, &cy);
      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.7 * NSEC_PER_SEC)),
                     dispatch_get_main_queue(), ^{
        char buf[256];
        snprintf(buf, sizeof(buf), "{\\"event\\":\\"mousedown\\",\\"x\\":%g,\\"y\\":%g}", cx, cy);
        emit(buf);
        snprintf(buf, sizeof(buf), "{\\"event\\":\\"mouseup\\",\\"x\\":%g,\\"y\\":%g}", cx, cy);
        emit(buf);
      });
    }

    [win makeKeyAndOrderFront:nil];
    [win makeFirstResponder:gView];
    [NSApp activateIgnoringOtherApps:YES];
    // The Tov side may attach its line reader after the first setFrameSize;
    // re-announce geometry once the run loop is up.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{ [gView emitGeometry]; });
    [NSApp run];
  }
  return 0;
}
`

function helperPath(): string {
  const home = (process.env.HOME ?? process.env.USERPROFILE)!
  const dir = path.join(home, ".cache", "mytov")
  const src = path.join(dir, "mytov-window.m")
  const bin = path.join(dir, "mytov-window")
  const cached = existsSync(src) && try readFileSync(src, "utf8") === HELPER_SRC
  if (existsSync(bin) && cached) return bin
  try mkdirSync(dir, { recursive: true })
  try writeFileSync(src, HELPER_SRC)
  try execFileSync("clang", ["-fobjc-arc", "-O2", "-framework", "Cocoa", "-o", bin, src])
  return bin
}

// --- run ---------------------------------------------------------------

export type AppOptions = { title?: string, width?: int, height?: int, view: () => View }

// Event packets from the helper. `key` is charactersIgnoringModifiers,
// `code` the macOS keyCode; mods is a bitmask (cmd 1, shift 2, alt 4, ctrl 8).
type Ev = {
  event: string,
  x?: f64, y?: f64,
  w?: f64, h?: f64,
  dx?: f64, dy?: f64,
  id?: int, scale?: f64,
  key?: string, code?: int, mods?: int, repeat?: bool,
}

export const MOD_CMD = 1
export const MOD_SHIFT = 2
export const MOD_ALT = 4
export const MOD_CTRL = 8

let lastCmds: Cmd[] = []
let winW = 480.0
let winH = 360.0
// Points, not pixels: every coordinate and text size is in points, and the
// helper draws vectorially, so Retina output is automatic. winScale is the
// window's backing factor, kept for when a view needs pixel alignment.
let winScale = 1.0
let lastFrame = ""
let lastHits: Hit[] = []
let stdin: Js | undefined = undefined
let measureSeq = 0
const measureKeys: Map<int, string> = new Map()
const measureWaiters: Map<int, (s: Size) => void> = new Map()
let hoverIdx = -1
let pressedIdx = -1
let focusIdx = -1
let winFocused = false

// Topmost hit region at a point (later entries draw on top).
export function hitAt(x: f64, y: f64, hits: Hit[]): int {
  for (let i = hits.length - 1; i >= 0; i -= 1) {
    const b = hits[i]!.box
    if (x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h) return i
  }
  return -1
}

function resolveMeasure(ev: Ev) {
  if (ev.id === undefined || ev.w === undefined || ev.h === undefined) return
  const key = measureKeys.get(ev.id)
  if (key === undefined) return
  const size = { w: ev.w, h: ev.h }
  textCache.set(key, size)
  inflight.delete(key)
  const waiter = measureWaiters.get(ev.id)
  if (waiter !== undefined) {
    measureWaiters.delete(ev.id)
    waiter(size)
  }
}

const KEY_ENTER = 36
const KEY_SPACE = 49
const KEY_TAB = 48

function nextFocusable(from: int, dir: int): int {
  const n = lastHits.length
  for (let step = 1; step <= n; step += 1) {
    const i = ((from + dir * step) % n + n) % n
    if (lastHits[i]!.on.focusable === true) return i
  }
  return -1
}

// Apply one helper event to window state. Returns true when a re-render is
// warranted (state or damage changed); "measured" is handled separately.
export function dispatchEvent(ev: Ev): bool {
  const pt = ev.x !== undefined && ev.y !== undefined
  switch (ev.event) {
    case "mousedown":
      pressedIdx = pt ? hitAt(ev.x!, ev.y!, lastHits) : -1
      if (pressedIdx >= 0 && lastHits[pressedIdx]!.on.focusable === true) focusIdx = pressedIdx
      return true
    case "rightdown":
      // Context menus land with desktop-menus; for now treat as a click.
      pressedIdx = pt ? hitAt(ev.x!, ev.y!, lastHits) : -1
      return true
    case "mouseup": {
      const was = pressedIdx
      pressedIdx = -1
      if (was >= 0 && pt && hitAt(ev.x!, ev.y!, lastHits) === was) {
        const click = lastHits[was]!.on.click
        if (click !== undefined) click()
      }
      return true
    }
    case "mousemove": {
      const i = pt ? hitAt(ev.x!, ev.y!, lastHits) : -1
      if (i === hoverIdx) return false
      if (hoverIdx >= 0) {
        const h = lastHits[hoverIdx]!.on.hover
        if (h !== undefined) h(false)
      }
      hoverIdx = i
      if (i >= 0) {
        const h = lastHits[i]!.on.hover
        if (h !== undefined) h(true)
      }
      return true
    }
    case "scroll": {
      if (!pt) return false
      for (let i = lastHits.length - 1; i >= 0; i -= 1) {
        const h = lastHits[i]!
        const b = h.box
        const scroll = h.on.scroll
        if (scroll !== undefined && ev.x! >= b.x && ev.x! < b.x + b.w && ev.y! >= b.y && ev.y! < b.y + b.h) {
          scroll(ev.dx ?? 0, ev.dy ?? 0)
          return true
        }
      }
      return false
    }
    case "keydown": {
      const ke: KeyEv = { code: ev.code ?? 0, key: ev.key ?? "", mods: ev.mods ?? 0, repeat: ev.repeat ?? false }
      if (ke.code === KEY_TAB) {
        focusIdx = nextFocusable(focusIdx, (ke.mods & MOD_SHIFT) !== 0 ? -1 : 1)
        return true
      }
      const focused = focusIdx >= 0 && focusIdx < lastHits.length ? lastHits[focusIdx] : undefined
      const keyHandler = focused?.on?.key
      if (keyHandler !== undefined) {
        keyHandler(ke)
        return true
      }
      if ((ke.code === KEY_ENTER || ke.code === KEY_SPACE) && focused !== undefined) {
        const click = focused.on.click
        if (click !== undefined) click()
        return true
      }
      return false
    }
    case "keyup": {
      const focused = focusIdx >= 0 && focusIdx < lastHits.length ? lastHits[focusIdx] : undefined
      const keyHandler = focused?.on?.key
      if (keyHandler !== undefined) {
        keyHandler({ code: ev.code ?? 0, key: ev.key ?? "", mods: ev.mods ?? 0, repeat: ev.repeat ?? false })
        return true
      }
      return false
    }
    case "flags":
      return false
    case "focus":
      winFocused = true
      return false
    case "blur":
      winFocused = false
      return true
    case "resize":
      winW = ev.w ?? winW
      winH = ev.h ?? winH
      winScale = ev.scale ?? winScale
      return true
  }
  return false
}

export function run(opts: AppOptions) throws Error | JsError {
  winW = opts.width ?? 480
  winH = opts.height ?? 360
  const view = opts.view

  const child = try spawn(helperPath(), [opts.title ?? "mytov", `${winW}`, `${winH}`], {
    stdio: ["pipe", "pipe", "inherit"],
  })
  stdin = child.stdin

  const rl = try createInterface({ input: child.stdout })
  const debug = process.env.MYTOV_DEBUG !== undefined
  try rl.on("line", (line: Js) => {
    if (debug) console.log(`window> ${line as string}`)
    try {
      const ev = try JSON.parse(line as string) as Ev
      if (ev.event === "measured") {
        resolveMeasure(ev)
      } else if (dispatchEvent(ev)) {
        render(view)
      }
    } catch (e) {
      console.error(`mytov: ${e.message}`)
    }
  })
  try child.on("exit", () => process.exit(0))

  render(view)
  // The event loop must stay alive for the helper's stdout lines (and JS
  // callbacks generally) to be delivered; there is no server to hold it.
  setInterval(() => {}, 50)
}

// Re-render after state may have changed. Runs as a detached task: measure
// round-trips make it async, and channel errors are logged (a dead helper
// means the process is on its way out anyway).
export function cmdBox(c: Cmd): Box {
  return { x: c.x, y: c.y, w: c.w, h: c.h }
}

// Rectangles the helper must repaint to go from `old` to `now`: the box of
// every command that changed, moved, appeared, or vanished. The lists are
// positionally stable for a stable tree shape, so index-wise diffing is
// exact; a length change damages the tail.
export function damageRects(old: Cmd[], now: Cmd[]): Box[] {
  let out: Box[] = []
  const n = Math.max(old.length, now.length)
  for (let i = 0; i < n; i += 1) {
    const a = i < old.length ? old[i] : undefined
    const b = i < now.length ? now[i] : undefined
    const same = a !== undefined && b !== undefined && JSON.stringify(a) === JSON.stringify(b)
    if (!same) {
      if (a !== undefined) out.push(cmdBox(a))
      if (b !== undefined) out.push(cmdBox(b))
    }
  }
  return out
}

function render(view: () => View) {
  renderFrame(view)
}

async function renderFrame(view: () => View) {
  try {
    await renderPass(view)
  } catch (e) {
    console.error(`mytov: ${e.message}`)
  }
}

async function renderPass(view: () => View) throws Error {
  const v = view()
  let runs: TextRun[] = []
  let seen: Set<string> = new Set()
  collectRuns(v, &runs, &seen)
  const waits: Promise<Size>[] = []
  for (const r of runs) {
    const id = measureSeq
    measureSeq += 1
    const key = textKey(r)
    measureKeys.set(id, key)
    inflight.add(key)
    waits.push(new Promise<Size>((resolve) => measureWaiters.set(id, resolve)))
    try stdin!.write(`{"measure":{"id":${id},"s":${JSON.stringify(r.s)},"size":${r.size},"bold":${r.bold}}}\n`)
  }
  try await Promise.all(waits)
  const l = layout(v, winW, winH, { hover: hoverIdx, pressed: pressedIdx, focus: winFocused ? focusIdx : -1 })
  lastHits = l.hits
  const json = JSON.stringify(l.frame)
  if (json !== lastFrame) {
    const damage = damageRects(lastCmds, l.frame.frame)
    lastCmds = l.frame.frame
    lastFrame = json
    try stdin!.write(JSON.stringify({ frame: l.frame.frame, damage }) + "\n")
  }
}
