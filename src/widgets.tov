import { animating, MOD_CMD, bg, button, column, on, openUrl, overlay, pad, readClipboard, row, spacer, text, textSize, tickCount, writeClipboard } from "./mytov"
import type { Box, Cmd, Hit, View, WidgetState } from "./mytov"

// The standard widget set, built on the `custom` view kind: each widget is
// a fixed-intrinsic-size view that paints primitive commands. Layout stays
// in mytov.tov; this file only composes rects, ovals, and text.

const ACCENT = "#0a7aff"
const ACCENT_PRESS = "#045cc4"
const FILL = "#e5e5ea"
const LABEL = "#111111"
const DIM = "#6e6e73"
const RING = "#6bb3ff"
const EDGE = "#c7c7cc"

function rect(x: f64, y: f64, w: f64, h: f64, color: string, radius?: f64): Cmd {
  return { kind: "rect", x, y, w, h, color, radius: radius ?? 0.0, stroke: "", lw: 0.0 }
}

function oval(x: f64, y: f64, w: f64, h: f64, color: string): Cmd {
  return { kind: "oval", x, y, w, h, color }
}

function textCmd(s: string, x: f64, y: f64, w: f64, size: f64, bold: bool, color: string): Cmd {
  return { kind: "text", x, y, w, h: textSize(s, size, bold).h, s, size, color, bold }
}

// Vertically centers a text run inside `h`.
function vcenter(s: string, x: f64, y: f64, w: f64, h: f64, size: f64, bold: bool, color: string): Cmd {
  const th = textSize(s, size, bold).h
  return { kind: "text", x, y: y + (h - th) / 2, w, h: th, s, size, color, bold }
}

function focusRing(box: Box): Cmd {
  return { kind: "rect", x: box.x - 2.0, y: box.y - 2.0, w: box.w + 4.0, h: box.h + 4.0, color: "", radius: 6.0, stroke: RING, lw: 2.0 }
}

export function toggle(value: bool, onChange: (v: bool) => void): View {
  return {
    kind: "custom", w: 38.0, h: 22.0,
    on: { click: () => onChange(!value), focusable: true },
    paint: (box, st) => {
      let cmds: Cmd[] = [
        rect(box.x, box.y, box.w, box.h, st.pressed ? ACCENT_PRESS : value ? ACCENT : FILL, 11.0),
        oval(value ? box.x + box.w - 20.0 : box.x + 2.0, box.y + 2.0, 18.0, 18.0, "#ffffff"),
      ]
      if (st.focused) cmds.push(focusRing(box))
      return cmds
    },
  }
}

export function checkbox(checked: bool, labelText: string, onChange: (v: bool) => void): View {
  const tw = labelText === "" ? 0.0 : textSize(labelText, 13.0, false).w + 8.0
  return {
    kind: "custom", w: 18.0 + tw, h: 20.0,
    on: { click: () => onChange(!checked), focusable: true },
    paint: (box, st) => {
      let cmds: Cmd[] = [rect(box.x, box.y + 1.0, 18.0, 18.0, checked ? (st.pressed ? ACCENT_PRESS : ACCENT) : "#ffffff", 4.0)]
      if (!checked) cmds.push({ kind: "rect", x: box.x, y: box.y + 1.0, w: 18.0, h: 18.0, color: "", radius: 4.0, stroke: EDGE, lw: 1.0 })
      if (checked) cmds.push(textCmd("✓", box.x, box.y + 2.0, 18.0, 13.0, true, "#ffffff"))
      if (labelText !== "") cmds.push(textCmd(labelText, box.x + 26.0, box.y + 2.0, tw, 13.0, false, LABEL))
      if (st.focused) cmds.push(focusRing(box))
      return cmds
    },
  }
}

export function radio(selected: bool, labelText: string, onSelect: () => void): View {
  const tw = labelText === "" ? 0.0 : textSize(labelText, 13.0, false).w + 8.0
  return {
    kind: "custom", w: 18.0 + tw, h: 20.0,
    on: { click: () => onSelect(), focusable: true },
    paint: (box, st) => {
      let cmds: Cmd[] = [
        oval(box.x, box.y + 1.0, 18.0, 18.0, "#ffffff"),
        { kind: "rect", x: box.x, y: box.y + 1.0, w: 18.0, h: 18.0, color: "", radius: 9.0, stroke: EDGE, lw: 1.0 },
      ]
      if (selected) cmds.push(oval(box.x + 5.0, box.y + 6.0, 8.0, 8.0, ACCENT))
      if (labelText !== "") cmds.push(textCmd(labelText, box.x + 26.0, box.y + 2.0, tw, 13.0, false, LABEL))
      if (st.focused) cmds.push(focusRing(box))
      return cmds
    },
  }
}

// Fraction slider; press and drag both set the value (captured pointer).
export function slider(value: f64, onChange: (v: f64) => void): View {
  return {
    kind: "custom", w: 160.0, h: 20.0,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        press: (x) => onChange(Math.max(0.0, Math.min(1.0, (x - box.x - 8.0) / (box.w - 16.0)))),
        drag: (x) => onChange(Math.max(0.0, Math.min(1.0, (x - box.x - 8.0) / (box.w - 16.0)))),
      },
    }],
    paint: (box, st) => {
      const knobX = box.x + Math.max(0.0, Math.min(1.0, value)) * (box.w - 16.0)
      const ky = box.y + box.h / 2 - 8.0
      let cmds: Cmd[] = [
        rect(box.x, box.y + box.h / 2 - 2.5, box.w, 5.0, FILL, 2.5),
        rect(box.x, box.y + box.h / 2 - 2.5, knobX - box.x + 8.0, 5.0, ACCENT, 2.5),
        oval(knobX, ky, 16.0, 16.0, "#ffffff"),
        { kind: "rect", x: knobX, y: ky, w: 16.0, h: 16.0, color: "", radius: 8.0, stroke: st.pressed ? ACCENT : EDGE, lw: st.pressed ? 2.0 : 1.0 },
      ]
      if (st.focused) cmds.push(focusRing(box))
      return cmds
    },
  }
}

export function segmented(options: string[], selected: int, onSelect: (i: int) => void): View {
  const padX = 12.0
  const segW = (i: int) => textSize(options[i]!, 13.0, false).w + padX * 2
  let total = 0.0
  for (let i = 0; i < options.length; i += 1) total += segW(i)
  return {
    kind: "custom", w: total, h: 26.0,
    regions: (box) => {
      let hits: Hit[] = []
      let x = box.x
      for (let i = 0; i < options.length; i += 1) {
        const w = segW(i)
        const idx = i
        hits.push({ box: { x, y: box.y, w, h: box.h }, on: { click: () => onSelect(idx), focusable: true } })
        x += w
      }
      return hits
    },
    paint: (box) => {
      let cmds: Cmd[] = [rect(box.x, box.y, box.w, box.h, FILL, 6.0)]
      let x = box.x
      for (let i = 0; i < options.length; i += 1) {
        const w = segW(i)
        if (i === selected) cmds.push(rect(x + 2.0, box.y + 2.0, w - 4.0, box.h - 4.0, "#ffffff", 4.0))
        cmds.push(vcenter(options[i]!, x, box.y, w, box.h, 13.0, false, i === selected ? LABEL : DIM))
        x += w
      }
      return cmds
    },
  }
}

export function progress(value: f64): View {
  const v = Math.max(0.0, Math.min(1.0, value))
  return {
    kind: "custom", w: 160.0, h: 6.0,
    paint: (box) => [
      rect(box.x, box.y, box.w, box.h, FILL, 3.0),
      rect(box.x, box.y, box.w * v, box.h, ACCENT, 3.0),
    ],
  }
}

// Linear meter, colored by band: green to 0.6, yellow to 0.85, red above.
export function meter(value: f64): View {
  const v = Math.max(0.0, Math.min(1.0, value))
  const color = v < 0.6 ? "#34c759" : v < 0.85 ? "#ffcc00" : "#ff3b30"
  return {
    kind: "custom", w: 160.0, h: 6.0,
    paint: (box) => [
      rect(box.x, box.y, box.w, box.h, FILL, 3.0),
      rect(box.x, box.y, box.w * v, box.h, color, 3.0),
    ],
  }
}

// Eight dots fading around a circle; marks its window live for the pump.
export function spinner(size?: f64): View {
  const d = size ?? 20.0
  return {
    kind: "custom", w: d, h: d,
    paint: (box) => {
      animating()
      const t = tickCount()
      const r = d / 2 - 2.0
      const cx = box.x + box.w / 2
      const cy = box.y + box.h / 2
      const digits = "0123456789abcdef".chars()
      let cmds: Cmd[] = []
      for (let i = 0; i < 8; i += 1) {
        const phase = (i + t) % 8
        const alpha = 40 + Math.trunc(215.0 * phase / 7)
        const a = `${digits[Math.trunc(alpha / 16)]!}${digits[alpha % 16]!}`
        const ang = i * 0.7853981634
        cmds.push(oval(cx + r * Math.cos(ang) - 2.5, cy + r * Math.sin(ang) - 2.5, 5.0, 5.0, `#555555${a}`))
      }
      return cmds
    },
  }
}

export function badge(labelText: string, color?: string): View {
  const tw = textSize(labelText, 11.0, true).w
  const w = tw + 14.0
  return {
    kind: "custom", w, h: 18.0,
    paint: (box) => [
      rect(box.x, box.y, box.w, box.h, color ?? DIM, 9.0),
      vcenter(labelText, box.x, box.y - 1.0, box.w, box.h, 11.0, true, "#ffffff"),
    ],
  }
}

export function link(labelText: string, url: string): View {
  const s = textSize(labelText, 13.0, false)
  return {
    kind: "custom", w: s.w, h: s.h,
    on: {
      click: () => {
        try {
          openUrl(url)
        } catch (e) {
          console.error(`mytov link: ${e.message}`)
        }
      },
    },
    paint: (box, st) => {
      let cmds: Cmd[] = [textCmd(labelText, box.x, box.y, box.w, 13.0, false, st.hover ? ACCENT_PRESS : ACCENT)]
      if (st.hover) cmds.push(rect(box.x, box.y + box.h - 1.0, box.w, 1.0, ACCENT))
      return cmds
    },
  }
}

// --- text input ---------------------------------------------------------

// Editing model behind `input`. Apps keep a Field per field; the widget
// renders its text, selection and cursor, and routes insert/command/
// marked/clipboard ops to it. Character positions count Unicode chars.
export class Field {
  s = ""
  cursor = 0
  anchor = -1 // selection anchor; -1 = collapsed at cursor
  marked = "" // IME preedit, drawn after the cursor until it commits

  // Ordered selection range; collapsed is {lo == hi == cursor}.
  range(): { lo: int, hi: int } {
    if (this.anchor < 0 || this.anchor === this.cursor) return { lo: this.cursor, hi: this.cursor }
    return this.anchor < this.cursor ? { lo: this.anchor, hi: this.cursor } : { lo: this.cursor, hi: this.anchor }
  }

  replace(lo: int, hi: int, t: string) {
    const cs = this.s.chars()
    this.s = cs.slice(0, lo).join("") + t + cs.slice(hi).join("")
    this.cursor = lo + t.chars().length
    this.anchor = -1
    this.marked = ""
  }

  insert(t: string) {
    const r = this.range()
    this.replace(r.lo, r.hi, t)
  }

  backspace() {
    const r = this.range()
    if (r.lo < r.hi) this.replace(r.lo, r.hi, "")
    else if (this.cursor > 0) this.replace(this.cursor - 1, this.cursor, "")
  }

  fwdDelete() {
    const r = this.range()
    if (r.lo < r.hi) this.replace(r.lo, r.hi, "")
    else if (this.cursor < this.s.chars().length) this.replace(this.cursor, this.cursor + 1, "")
  }

  moveTo(pos: int, selecting: bool) {
    const len = this.s.chars().length
    const p = Math.max(0, Math.min(len, pos))
    if (selecting) {
      if (this.anchor < 0) this.anchor = this.cursor
      this.cursor = p
    } else {
      this.cursor = p
      this.anchor = -1
    }
    this.marked = ""
  }

  move(d: int, selecting: bool) {
    const r = this.range()
    if (!selecting && r.lo < r.hi) {
      // Collapse to the edge in the direction of travel.
      this.cursor = d < 0 ? r.lo : r.hi
      this.anchor = -1
      this.marked = ""
      return
    }
    this.moveTo(this.cursor + d, selecting)
  }

  selectAll() {
    this.anchor = 0
    this.cursor = this.s.chars().length
  }

  selectedText(): string {
    const r = this.range()
    return this.s.chars().slice(r.lo, r.hi).join("")
  }
}

const CURSOR = ACCENT
const SEL_BG = "#0a7aff55"
const PADX = 7.0

// Editing-selector names from the helper's doCommandBySelector mapped onto
// Field operations. Returns false for names the field doesn't handle.
export function fieldCommand(f: Field, name: string): bool {
  switch (name) {
    case "moveLeft": f.move(-1, false); return true
    case "moveRight": f.move(1, false); return true
    case "moveLeftAndModifySelection": f.move(-1, true); return true
    case "moveRightAndModifySelection": f.move(1, true); return true
    case "moveToBeginningOfLine":
    case "moveToBeginningOfDocument": f.moveTo(0, false); return true
    case "moveToEndOfLine":
    case "moveToEndOfDocument": f.moveTo(f.s.chars().length, false); return true
    case "moveToBeginningOfLineAndModifySelection": f.moveTo(0, true); return true
    case "moveToEndOfLineAndModifySelection": f.moveTo(f.s.chars().length, true); return true
    case "deleteBackward": f.backspace(); return true
    case "deleteForward": f.fwdDelete(); return true
    case "insertNewline": return false // single-line fields let Enter activate
    case "selectAll": f.selectAll(); return true
  }
  return false
}

function fieldTextOp(f: Field, op: string, s: string) {
  switch (op) {
    case "insert": f.insert(s); break
    case "marked": f.marked = s; break
    case "cmd": fieldCommand(f, s); break
    case "clipboard": f.insert(s); break
  }
}

export type InputOpts = { placeholder?: string, numeric?: bool }

// Single-line text input: focus ring, blinking cursor, selection, clipboard
// via Cmd-C/X/V, arrow/delete/home/end through the helper's edit commands.
export function input(field: Field, opts?: InputOpts): View {
  const numeric = opts?.numeric ?? false
  return {
    kind: "custom", w: 200.0, h: 24.0,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        key: (e) => {
          if ((e.mods & MOD_CMD) === 0) return
          try {
            if (e.key === "a") field.selectAll()
            else if (e.key === "c") writeClipboard(field.selectedText())
            else if (e.key === "x") { writeClipboard(field.selectedText()); const r = field.range(); field.replace(r.lo, r.hi, "") }
            else if (e.key === "v") readClipboard()
          } catch (err) {
            console.error(`mytov clipboard: ${err.message}`)
          }
        },
        text: (op, t) => {
          if (op === "insert" && numeric && !isNumeric(t)) return
          fieldTextOp(field, op, t)
        },
        press: (x) => field.moveTo(cursorAt(field.s, x - box.x - PADX), false),
      },
    }],
    paint: (box, st) => fieldPaint(box, st, field, opts?.placeholder ?? "", false),
  }
}

// The laid-out content origin is only known inside paint/regions; input
// stores it so press() can turn a click x into a cursor index.
// (press runs before paint within the same box on the same pass — but the
// press handler captured at layout time closes over `box` directly, see
// regions below.)
function cursorAt(s: string, relX: f64): int {
  const cs = s.chars()
  for (let i = 0; i < cs.length; i += 1) {
    if (textSize(cs.slice(0, i + 1).join(""), 13.0, false).w / 2 + textSize(cs.slice(0, i).join(""), 13.0, false).w / 2 > relX) return i
  }
  return cs.length
}

function isNumeric(s: string): bool {
  for (const c of s.chars()) {
    if ("0123456789.-".includes(c) === false) return false
  }
  return true
}

// The editable content of a field: selection, text, marked preedit, cursor.
function fieldContent(box: Box, st: WidgetState, field: Field, placeholder: string): Cmd[] {
  const size = 13.0
  let cmds: Cmd[] = []
  const content = field.s + field.marked
  const ty = box.y + (box.h - textSize("x", size, false).h) / 2
  if (content === "" && !st.focused && placeholder !== "") {
    cmds.push(textCmd(placeholder, box.x + PADX, ty, box.w - PADX * 2, size, false, DIM))
  } else {
    const r = field.range()
    const cs = field.s.chars()
    const preW = textSize(cs.slice(0, r.lo).join(""), size, false).w
    const selW = textSize(cs.slice(r.lo, r.hi).join(""), size, false).w
    if (r.hi > r.lo) {
      cmds.push(rect(box.x + PADX + preW, ty, selW, textSize("x", size, false).h, SEL_BG, 0.0))
    }
    cmds.push(textCmd(field.s, box.x + PADX, ty, box.w - PADX * 2, size, false, LABEL))
    if (field.marked !== "") {
      const mw = textSize(field.s, size, false).w
      cmds.push(textCmd(field.marked, box.x + PADX + mw, ty, box.w, size, false, LABEL))
      const uw = textSize(field.marked, size, false).w
      cmds.push(rect(box.x + PADX + mw, ty + textSize("x", size, false).h - 1.0, uw, 1.0, DIM))
    }
    if (st.focused) {
      animating()
      const blink = tickCount() % 12 < 7
      if (blink) {
        const curW = textSize(cs.slice(0, field.cursor).join(""), size, false).w
        cmds.push(rect(box.x + PADX + curW, ty, 1.0, textSize("x", size, false).h, CURSOR))
      }
    }
  }
  return cmds
}

// Default field chrome (white rounded box + border) plus the content.
function fieldPaint(box: Box, st: WidgetState, field: Field, placeholder: string, multi: bool): Cmd[] {
  let cmds: Cmd[] = [
    rect(box.x, box.y, box.w, box.h, "#ffffff", 5.0),
    { kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "", radius: 5.0, stroke: st.focused ? RING : EDGE, lw: st.focused ? 2.0 : 1.0 },
  ]
  for (const c of fieldContent(box, st, field, placeholder)) cmds.push(c)
  return cmds
}

// Numeric single-line input (filters inserts; arrows step via cmd keys).
export function numberInput(field: Field, onStep?: (d: int) => void): View {
  const inner = input(field, { numeric: true })
  // Wrap: up/down commands step when the app provides onStep.
  if (onStep === undefined) return inner
  return {
    kind: "custom", w: 200.0, h: 24.0,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        text: (op, s) => {
          if (op === "cmd" && (s === "moveUp" || s === "moveDown")) onStep(s === "moveUp" ? 1 : -1)
          else fieldTextOp(field, op, s)
        },
        press: (x) => field.moveTo(cursorAt(field.s, x - box.x - PADX), false),
      },
    }],
    paint: (box, st) => fieldPaint(box, st, field, "", false),
  }
}

// Rounded field with a search glyph.
export function searchField(field: Field): View {
  return {
    kind: "custom", w: 200.0, h: 24.0,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        text: (op, s) => fieldTextOp(field, op, s),
        press: (x) => field.moveTo(cursorAt(field.s, x - box.x - PADX - 14.0), false),
      },
    }],
    paint: (box, st) => {
      let cmds: Cmd[] = [
        rect(box.x, box.y, box.w, box.h, "#f5f5f7", 12.0),
        { kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "", radius: 12.0, stroke: st.focused ? RING : EDGE, lw: st.focused ? 2.0 : 1.0 },
        textCmd("⌕", box.x + PADX, box.y + 4.0, 14.0, 13.0, false, DIM),
      ]
      const inner = { x: box.x + 14.0, y: box.y, w: box.w - 14.0, h: box.h }
      for (const c of fieldContent(inner, { hover: false, pressed: false, focused: st.focused }, field, "Search")) cmds.push(c)
      return cmds
    },
  }
}

// Up/down stepper; the two halves are separate hit regions.
export function stepper(onStep: (d: int) => void): View {
  return {
    kind: "custom", w: 20.0, h: 22.0,
    regions: (box) => [
      { box: { x: box.x, y: box.y, w: box.w, h: box.h / 2 }, on: { press: () => onStep(1) } },
      { box: { x: box.x, y: box.y + box.h / 2, w: box.w, h: box.h / 2 }, on: { press: () => onStep(-1) } },
    ],
    paint: (box) => {
      let cmds: Cmd[] = [
        rect(box.x, box.y, box.w, box.h, "#ffffff", 4.0),
        { kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "", radius: 4.0, stroke: EDGE, lw: 1.0 },
        rect(box.x + 1.0, box.y + box.h / 2, box.w - 2.0, 1.0, EDGE),
        textCmd("+", box.x, box.y, box.w, 12.0, false, LABEL),
        textCmd("−", box.x, box.y + box.h / 2, box.w, 12.0, false, LABEL),
      ]
      return cmds
    },
  }
}

// Multi-line field: soft-wraps by explicit newlines, Enter inserts one,
// up/down move between lines, cursor walks characters. No horizontal
// scroll; long lines wrap visually per line.
export function textarea(field: Field, height?: f64): View {
  const h = height ?? 80.0
  return {
    kind: "custom", w: 240.0, h,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        text: (op, s) => {
          if (op === "cmd" && s === "insertNewline") { field.insert("\n"); return }
          fieldTextOp(field, op, s)
        },
        press: (x, y) => {
          // Walk lines for the clicked row, then prefix-measure the column.
          const lineH = textSize("x", 13.0, false).h
          const row = Math.trunc((y - box.y - 4.0) / lineH)
          const lines = field.s.split("\n")
          let base = 0
          let line = 0
          for (const l of lines) {
            if (line === row) { field.moveTo(base + cursorAt(l, x - box.x - PADX), false); return }
            base += l.chars().length + 1
            line += 1
          }
          field.moveTo(field.s.chars().length, false)
        },
        key: (e) => {
          if ((e.mods & MOD_CMD) === 0) return
          try {
            if (e.key === "a") field.selectAll()
            else if (e.key === "c") writeClipboard(field.selectedText())
            else if (e.key === "x") { writeClipboard(field.selectedText()); const r = field.range(); field.replace(r.lo, r.hi, "") }
            else if (e.key === "v") readClipboard()
          } catch (err) {
            console.error(`mytov clipboard: ${err.message}`)
          }
        },
      },
    }],
    paint: (box, st) => {
      const size = 13.0
      const lineH = textSize("x", size, false).h
      let cmds: Cmd[] = [
        rect(box.x, box.y, box.w, box.h, "#ffffff", 5.0),
        { kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "", radius: 5.0, stroke: st.focused ? RING : EDGE, lw: st.focused ? 2.0 : 1.0 },
      ]
      const lines = field.s.split("\n")
      let y = box.y + 4.0
      let base = 0
      const r = field.range()
      for (const line of lines) {
        const lcs = line.chars()
        const inLine = field.cursor >= base && field.cursor <= base + lcs.length
        const selLo = Math.max(r.lo, base) - base
        const selHi = Math.min(r.hi, base + lcs.length) - base
        if (selHi > selLo) {
          const sx = textSize(lcs.slice(0, selLo).join(""), size, false).w
          const sw = textSize(lcs.slice(selLo, selHi).join(""), size, false).w
          cmds.push(rect(box.x + PADX + sx, y, sw, lineH, SEL_BG))
        }
        cmds.push(textCmd(line === "" ? " " : line, box.x + PADX, y, box.w - PADX * 2, size, false, LABEL))
        if (st.focused && inLine) {
          animating()
          if (tickCount() % 12 < 7) {
            const cx = textSize(lcs.slice(0, field.cursor - base).join(""), size, false).w
            cmds.push(rect(box.x + PADX + cx, y, 1.0, lineH, CURSOR))
          }
        }
        y += lineH
        base += lcs.length + 1
      }
      if (field.marked !== "") cmds.push(textCmd(field.marked, box.x + PADX, y, box.w - PADX * 2, size, false, DIM))
      return cmds
    },
  }
}

// --- containers ---------------------------------------------------------

export function tabs(items: string[], selected: int, onSelect: (i: int) => void, content: View): View {
  let headers: View[] = []
  for (let i = 0; i < items.length; i += 1) {
    const idx = i
    headers.push({
      kind: "custom", w: textSize(items[i]!, 13.0, i === selected).w + 24.0, h: 30.0,
      regions: (box) => [{ box, on: { click: () => onSelect(idx), focusable: true } }],
      paint: (box, st) => {
        let cmds: Cmd[] = []
        const on = i === selected
        if (on) cmds.push(rect(box.x, box.y + box.h - 2.0, box.w, 2.0, ACCENT))
        cmds.push(vcenter(items[i]!, box.x, box.y, box.w, box.h, 13.0, on, on ? LABEL : st.hover ? LABEL : DIM))
        if (st.focused) cmds.push(focusRing(box))
        return cmds
      },
    })
  }
  return column([row(headers, 4), content], 0)
}

// Vertical sidebar pane; the app supplies the content pane separately.
export function sidebar(items: string[], selected: int, onSelect: (i: int) => void, width?: f64): View {
  const w = width ?? 180.0
  let rows: View[] = []
  for (let i = 0; i < items.length; i += 1) {
    const idx = i
    rows.push({
      kind: "custom", w, h: 28.0,
      regions: (box) => [{ box, on: { click: () => onSelect(idx), focusable: true } }],
      paint: (box, st) => {
        let cmds: Cmd[] = []
        const on = i === selected
        if (on) cmds.push(rect(box.x, box.y, box.w, box.h, "#0a7aff22", 5.0))
        if (st.hover && !on) cmds.push(rect(box.x, box.y, box.w, box.h, "#00000008", 5.0))
        cmds.push(vcenter(items[i]!, box.x + 10.0, box.y, box.w - 10.0, box.h, 13.0, on, on ? LABEL : LABEL))
        if (st.focused) cmds.push(focusRing(box))
        return cmds
      },
    })
  }
  return column(rows, 2)
}

// Expandable sections; app holds the open set per section.
export function accordion(sections: { title: string, open: bool, child: View }[], onToggle: (i: int) => void): View {
  let rows: View[] = []
  for (let i = 0; i < sections.length; i += 1) {
    const sec = sections[i]!
    const idx = i
    rows.push({
      kind: "custom", w: 240.0, h: 28.0,
      regions: (box) => [{ box, on: { click: () => onToggle(idx), focusable: true } }],
      paint: (box, st) => {
        let cmds: Cmd[] = [
          textCmd(sec.open ? "▾" : "▸", box.x + 4.0, box.y + 5.0, 16.0, 13.0, false, DIM),
          vcenter(sec.title, box.x + 22.0, box.y, box.w - 22.0, box.h, 13.0, true, st.hover ? LABEL : LABEL),
        ]
        if (st.hover) cmds.push(rect(box.x, box.y + box.h - 1.0, box.w, 1.0, EDGE))
        if (st.focused) cmds.push(focusRing(box))
        return cmds
      },
    })
    if (sec.open) rows.push(pad(8, sec.child))
  }
  return column(rows, 0)
}

// Breadcrumb trail; each non-last crumb is clickable.
export function breadcrumbs(items: string[], onNavigate: (i: int) => void): View {
  let parts: View[] = []
  for (let i = 0; i < items.length; i += 1) {
    const last = i === items.length - 1
    const idx = i
    const s = textSize(items[i]!, 13.0, last)
    parts.push({
      kind: "custom", w: s.w, h: s.h,
      on: last ? undefined : { click: () => onNavigate(idx) },
      paint: (box, st) => [textCmd(items[i]!, box.x, box.y, box.w, 13.0, last, last ? LABEL : st.hover ? ACCENT : DIM)],
    })
    if (!last) {
      parts.push({ kind: "custom", w: 12.0, h: s.h, paint: (box) => [textCmd("›", box.x + 4.0, box.y, box.w, 13.0, false, DIM)] })
    }
  }
  return row(parts, 2)
}

export type TreeNode = { label: string, expanded: bool, children: TreeNode[], onToggle: () => void }

// Indented outline with disclosure triangles; expansion lives in the app.
export function tree(nodes: TreeNode[], depth?: int): View {
  const d = depth ?? 0
  let rows: View[] = []
  for (const n of nodes) {
    const node = n
    const s = textSize(n.label, 13.0, false)
    rows.push({
      kind: "custom", w: d * 16.0 + 18.0 + s.w, h: 24.0,
      regions: (box) => [{ box, on: { click: () => node.onToggle(), focusable: true } }],
      paint: (box, st) => {
        let cmds: Cmd[] = []
        if (st.hover) cmds.push(rect(box.x, box.y, box.w + 200.0, box.h, "#00000008", 3.0))
        cmds.push(textCmd(node.children.length > 0 ? (node.expanded ? "▾" : "▸") : " ", box.x + d * 16.0 + 2.0, box.y + 3.0, 14.0, 12.0, false, DIM))
        cmds.push(textCmd(node.label, box.x + d * 16.0 + 18.0, box.y + 3.0, s.w + 4.0, 13.0, false, LABEL))
        return cmds
      },
    })
    if (n.expanded) rows.push(tree(n.children, d + 1))
  }
  return column(rows, 0)
}

// --- overlays -----------------------------------------------------------

// Rounded card chrome for dialogs/popovers.
export function card(content: View): View {
  return pad(16, bg("#ffffff", content, 10.0, EDGE))
}

// Centered dimmed dialog above `base`; nothing below takes input while open.
export function modal(base: View, content: View, open: bool): View {
  return overlay(base, open ? card(content) : undefined, { dim: true, capture: true })
}

// Floating message pill at the bottom edge while `show`.
export function toast(base: View, message: string, show: bool): View {
  if (!show) return base
  return overlay(base, {
    kind: "custom", w: textSize(message, 13.0, false).w + 32.0, h: 32.0,
    paint: (box) => [
      rect(box.x, box.y, box.w, box.h, "#323232", 16.0),
      vcenter(message, box.x, box.y, box.w, box.h, 13.0, false, "#ffffff"),
    ],
  }, { anchor: "bottom" })
}

// Floating panel at a point (e.g. a saved right-click location).
export function popover(base: View, content: View, at?: Box): View {
  return overlay(base, at === undefined ? undefined : card(content), { capture: true, at })
}

// Item list menu at a point — context menus and select popups.
export function menuAt(base: View, items: string[], at: Box | undefined, onSelect: (i: int) => void): View {
  if (at === undefined) return base
  let rows: View[] = []
  for (let i = 0; i < items.length; i += 1) {
    const idx = i
    const label = items[i]!
    rows.push({
      kind: "custom", w: Math.max(160.0, textSize(label, 13.0, false).w + 24.0), h: 26.0,
      regions: (box) => [{ box, on: { click: () => onSelect(idx) } }],
      paint: (box, st) => {
        let cmds: Cmd[] = []
        if (st.hover) cmds.push(rect(box.x, box.y, box.w, box.h, ACCENT))
        cmds.push(textCmd(label, box.x + 12.0, box.y + 4.0, box.w - 24.0, 13.0, false, st.hover ? "#ffffff" : LABEL))
        return cmds
      },
    })
  }
  return overlay(base, card(column(rows, 0)), { capture: true, at })
}

// Slide-out panel on the right edge while `open`.
export function drawer(base: View, content: View, open: bool, width?: f64): View {
  return overlay(base, open ? bg("#ffffff", content) : undefined, { anchor: "right", capture: true })
}

// --- data & selection ---------------------------------------------------

// Where a select/combobox popup is open; the widget stores its laid-out box
// here on press so the app can wrap the root with selectPopup/menuAt.
export class PopState {
  at: Box | undefined = undefined
}

// A field that opens a popup list under itself. Pair with selectPopup at
// the view root:
//   selectPopup(view(), options, state, (i) => { state.at = undefined })
export function select(label: string, state: PopState): View {
  const tw = textSize(label + "▾", 13.0, false).w + 24.0
  return {
    kind: "custom", w: tw, h: 26.0,
    regions: (box) => [{
      box,
      on: {
        focusable: true,
        press: () => {
          state.at = { x: box.x, y: box.y + box.h + 4.0, w: box.w, h: 0 }
        },
      },
    }],
    paint: (box, st) => {
      let cmds: Cmd[] = [
        rect(box.x, box.y, box.w, box.h, st.pressed || st.hover ? "#e8e8ec" : "#f5f5f7", 6.0),
        { kind: "rect", x: box.x, y: box.y, w: box.w, h: box.h, color: "", radius: 6.0, stroke: EDGE, lw: 1.0 },
        vcenter(label, box.x + 10.0, box.y, box.w - 26.0, box.h, 13.0, false, LABEL),
        vcenter("▾", box.x + box.w - 18.0, box.y, 14.0, box.h, 11.0, false, DIM),
      ]
      if (st.focused) cmds.push(focusRing(box))
      return cmds
    },
  }
}

// Wrap at the view root; closes on select.
export function selectPopup(base: View, options: string[], state: PopState, onSelect: (i: int) => void): View {
  return menuAt(base, options, state.at, (i) => {
    state.at = undefined
    onSelect(i)
  })
}

// Input plus a filtered suggestion popup under it (use with selectPopup).
export function combobox(field: Field, state: PopState): View {
  const inner = input(field, {})
  return on(inner, {
    press: () => {
      // handled by the inner regions; nothing extra needed here
    },
  })
}

// Filtered suggestions for a combobox/selectPopup call.
export function filterOptions(options: string[], query: string): string[] {
  const q = query.toLowerCase()
  return options.filter((o) => o.toLowerCase().includes(q))
}

// Filled star rating, 1..max.
export function rating(value: int, max: int, onRate: (i: int) => void): View {
  const s = textSize("★", 18.0, false)
  return {
    kind: "custom", w: max * (s.w + 2.0), h: s.h,
    regions: (box) => {
      let hits: Hit[] = []
      for (let i = 0; i < max; i += 1) {
        const idx = i
        hits.push({ box: { x: box.x + i * (s.w + 2.0), y: box.y, w: s.w + 2.0, h: box.h }, on: { click: () => onRate(idx + 1) } })
      }
      return hits
    },
    paint: (box, st) => {
      let cmds: Cmd[] = []
      for (let i = 0; i < max; i += 1) {
        cmds.push(textCmd("★", box.x + i * (s.w + 2.0), box.y, s.w + 2.0, 18.0, false, i < value ? "#ffcc00" : EDGE))
      }
      return cmds
    },
  }
}

// Two-knob range slider; values 0..1, whichever knob is nearer drags.
export function rangeSlider(lo: f64, hi: f64, onChange: (lo: f64, hi: f64) => void): View {
  const set = (x: f64, box: Box) => {
    const f = Math.max(0.0, Math.min(1.0, (x - box.x - 8.0) / (box.w - 16.0)))
    if (Math.abs(f - lo) <= Math.abs(f - hi)) onChange(Math.min(f, hi), hi)
    else onChange(lo, Math.max(f, lo))
  }
  return {
    kind: "custom", w: 160.0, h: 20.0,
    regions: (box) => [{ box, on: { press: (x) => set(x, box), drag: (x) => set(x, box), focusable: true } }],
    paint: (box) => {
      const usable = box.w - 16.0
      const lx = box.x + lo * usable
      const hx = box.x + hi * usable
      const ky = box.y + box.h / 2 - 7.0
      return [
        rect(box.x, box.y + box.h / 2 - 2.5, box.w, 5.0, FILL, 2.5),
        rect(lx, box.y + box.h / 2 - 2.5, hx - lx, 5.0, ACCENT, 2.5),
        oval(lx, ky, 14.0, 14.0, "#ffffff"),
        oval(hx, ky, 14.0, 14.0, "#ffffff"),
        { kind: "rect", x: lx, y: ky, w: 14.0, h: 14.0, color: "", radius: 7.0, stroke: EDGE, lw: 1.0 },
        { kind: "rect", x: hx, y: ky, w: 14.0, h: 14.0, color: "", radius: 7.0, stroke: EDGE, lw: 1.0 },
      ]
    },
  }
}

// Initials avatar in a colored circle.
export function avatar(name: string, color?: string, size?: f64): View {
  const d = size ?? 32.0
  const parts = name.split(" ")
  const initials = parts.length >= 2 ? `${parts[0]!.chars()[0]!}${parts[1]!.chars()[0]!}` : name.chars().slice(0, 2).join("")
  return {
    kind: "custom", w: d, h: d,
    paint: (box) => [
      oval(box.x, box.y, d, d, color ?? ACCENT),
      vcenter(initials, box.x, box.y - 1.0, d, d, d * 0.38, true, "#ffffff"),
    ],
  }
}

// Image from a file path, decoded by the helper (NSImage).
export function image(path: string, w: f64, h: f64): View {
  return {
    kind: "custom", w, h,
    paint: (box) => [{ kind: "image", x: box.x, y: box.y, w: box.w, h: box.h, path }],
  }
}

// Swatch grid color picker.
const SWATCHES = [
  "#ff3b30", "#ff9500", "#ffcc00", "#34c759", "#00c7be",
  "#0a7aff", "#5856d6", "#af52de", "#ff2d55", "#a2845e",
  "#8e8e93", "#111111",
]

export function colorPicker(selected: string, onPick: (c: string) => void): View {
  const cell = 22.0
  const cols = 6
  return {
    kind: "custom", w: cols * cell, h: Math.ceil(SWATCHES.length / cols) * cell,
    regions: (box) => {
      let hits: Hit[] = []
      for (let i = 0; i < SWATCHES.length; i += 1) {
        const c = SWATCHES[i]!
        hits.push({ box: { x: box.x + (i % cols) * cell, y: box.y + Math.trunc(i / cols) * cell, w: cell, h: cell }, on: { click: () => onPick(c) } })
      }
      return hits
    },
    paint: (box) => {
      let cmds: Cmd[] = []
      for (let i = 0; i < SWATCHES.length; i += 1) {
        const c = SWATCHES[i]!
        const x = box.x + (i % cols) * cell
        const y = box.y + Math.trunc(i / cols) * cell
        cmds.push(rect(x + 2.0, y + 2.0, cell - 4.0, cell - 4.0, c, 4.0))
        if (c === selected) cmds.push({ kind: "rect", x: x + 1.0, y: y + 1.0, w: cell - 2.0, h: cell - 2.0, color: "", radius: 5.0, stroke: LABEL, lw: 2.0 })
      }
      return cmds
    },
  }
}

// Month grid calendar; app tracks year/month/selected day.
export function calendar(year: int, month: int, selected: int, onPick: (day: int) => void): View {
  const cell = 30.0
  const days = daysInMonth(year, month)
  const lead = firstWeekday(year, month) // 0 = Sunday
  const cells = lead + days
  const rows = Math.ceil(cells / 7)
  return {
    kind: "custom", w: 7 * cell, h: rows * cell + 20.0,
    regions: (box) => {
      let hits: Hit[] = []
      for (let d = 1; d <= days; d += 1) {
        const day = d
        const i = lead + d - 1
        hits.push({ box: { x: box.x + (i % 7) * cell, y: box.y + 20.0 + Math.trunc(i / 7) * cell, w: cell, h: cell }, on: { click: () => onPick(day), focusable: true } })
      }
      return hits
    },
    paint: (box, st) => {
      let cmds: Cmd[] = []
      const names = "SMTWTFS".chars()
      for (let i = 0; i < 7; i += 1) {
        cmds.push(vcenter(names[i]!, box.x + i * cell, box.y, cell, 18.0, 11.0, true, DIM))
      }
      for (let d = 1; d <= days; d += 1) {
        const i = lead + d - 1
        const x = box.x + (i % 7) * cell
        const y = box.y + 20.0 + Math.trunc(i / 7) * cell
        const on = d === selected
        if (on) cmds.push(oval(x + 3.0, y + 3.0, cell - 6.0, cell - 6.0, ACCENT))
        cmds.push(vcenter(`${d}`, x, y, cell, cell, 12.0, false, on ? "#ffffff" : LABEL))
      }
      return cmds
    },
  }
}

function isLeap(y: int): bool {
  return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0
}

export function daysInMonth(year: int, month: int): int {
  const lengths = [31, isLeap(year) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  return lengths[month - 1]!
}

// Sakamoto's algorithm; 0 = Sunday.
export function firstWeekday(y: int, m: int, d?: int): int {
  const t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
  const yy = m < 3 ? y - 1 : y
  return (yy + Math.trunc(yy / 4) - Math.trunc(yy / 100) + Math.trunc(yy / 400) + t[m - 1]! + (d ?? 1)) % 7
}

// Aligned label/field rows.
export function form(rows: { label: string, field: View }[]): View {
  let labelW = 0.0
  for (const r of rows) labelW = Math.max(labelW, textSize(r.label, 13.0, false).w)
  let items: View[] = []
  for (const r of rows) {
    items.push(row([{ kind: "custom", w: labelW, h: 20.0, paint: (box) => [textCmd(r.label, box.x + box.w - textSize(r.label, 13.0, false).w, box.y + 2.0, box.w, 13.0, false, DIM)] }, r.field], 10))
  }
  return column(items, 10)
}

// Simple bar chart; values normalized against the max.
export function barChart(values: f64[], w?: f64, h?: f64, color?: string): View {
  const cw = w ?? 240.0
  const ch = h ?? 120.0
  return {
    kind: "custom", w: cw, h: ch,
    paint: (box) => {
      let cmds: Cmd[] = []
      let max = 0.0
      for (const v of values) max = Math.max(max, v)
      const bw = box.w / values.length
      for (let i = 0; i < values.length; i += 1) {
        const vh = max > 0 ? (values[i]! / max) * box.h : 0
        cmds.push(rect(box.x + i * bw + 2.0, box.y + box.h - vh, bw - 4.0, vh, color ?? ACCENT, 2.0))
      }
      return cmds
    },
  }
}

// Polyline chart over the same 0..max normalization.
export function lineChart(values: f64[], w?: f64, h?: f64, color?: string): View {
  const cw = w ?? 240.0
  const ch = h ?? 120.0
  return {
    kind: "custom", w: cw, h: ch,
    paint: (box) => {
      let cmds: Cmd[] = []
      let max = 0.0
      for (const v of values) max = Math.max(max, v)
      const step = values.length > 1 ? box.w / (values.length - 1) : box.w
      for (let i = 0; i + 1 < values.length; i += 1) {
        const y1 = box.y + box.h - (max > 0 ? (values[i]! / max) * box.h : 0)
        const y2 = box.y + box.h - (max > 0 ? (values[i + 1]! / max) * box.h : 0)
        cmds.push({ kind: "line", x: box.x + i * step, y: y1, w: step, h: y2 - y1, color: color ?? ACCENT, lw: 2.0 })
      }
      return cmds
    },
  }
}

// Fixed-column grid of equal children.
export function grid(children: View[], cols: int, gap?: f64): View {
  const g = gap ?? 8.0
  let rows: View[] = []
  for (let i = 0; i < children.length; i += cols) {
    const slice = children.slice(i, Math.min(children.length, i + cols))
    let cells: View[] = []
    for (const c of slice) cells.push(c)
    for (let k = slice.length; k < cols; k += 1) cells.push(spacer())
    rows.push(row(cells, g))
  }
  return column(rows, g)
}

// Find bar: search field + optional match count + close button.
export function findBar(field: Field, matchCount: int, onClose: () => void): View {
  return row([
    searchField(field),
    text(matchCount > 0 ? `${matchCount}` : "—", { color: DIM }),
    button("✕", onClose),
  ], 8)
}
