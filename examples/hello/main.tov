import { button, column, newWindow, onDeepLink, onOpenFile, pad, run, setMenus, spacer, text } from "../../src/mytov"
import type { View } from "../../src/mytov"
import { updateWindow } from "../../src/updater"

class Counter {
  n = 0
}

const counter = new Counter()

function view(): View {
  return column(
    [
      text(`${counter.n}`, { size: 40, bold: true }),
      button("Increment", () => {
        counter.n += 1
        console.log(`count: ${counter.n}`)
      }),
    ],
    12,
  )
}

function about(): View {
  return pad(
    24,
    column(
      [
        text("mytov", { size: 24, bold: true }),
        text("native UI from Tov"),
        spacer(),
        text("second window", { color: "#666666" }),
      ],
      8,
    ),
  )
}

onDeepLink((url) => console.log(`deeplink: ${url}`))
onOpenFile((p) => console.log(`openfile: ${p}`))
try run({ title: "Counter", width: 480, height: 360, view })
try newWindow({ title: "About", width: 300, height: 220, view: about })
try setMenus([
  { title: "Hello", items: [{ label: "Check for Updates…", action: () => { try { updateWindow() } catch (e) {} } }] },
])
