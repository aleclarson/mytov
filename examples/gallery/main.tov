import { ScrollState, button, column, list, on, pad, row, run, setMenus, showMenu, spacer, split, SplitState, text } from "../../src/mytov"
import type { View } from "../../src/mytov"
import { Field, badge, checkbox, drawer, input, link, menuAt, meter, modal, numberInput, progress, radio, searchField, segmented, slider, spinner, stepper, textarea, toast, toggle } from "../../src/widgets"

class State {
  wifi = true
  dark = false
  choice = 0
  volume = 0.4
  seg = 0
  loading = true
  name = new Field()
  age = new Field()
  notes = new Field()
  q = new Field()
  listScroll = new ScrollState()
  splitPos = new SplitState()
  showDialog = false
  showToast = false
  ctxAt: { x: f64, y: f64, w: f64, h: f64 } | undefined = undefined
  drawerOpen = false
}

const s = new State()

function labeled(labelText: string, child: View): View {
  return row([text(labelText, { color: "#6e6e73" }), spacer(), child], 12)
}

function view(): View {
  const base = pad(
    24,
    column(
      [
        row([text("mytov widgets", { size: 22, bold: true }), spacer(), badge("beta", "#ff9500")]),
        labeled("Wi-Fi", toggle(s.wifi, (v) => { s.wifi = v })),
        labeled("Notifications", checkbox(s.dark, "Enabled", (v) => { s.dark = v })),
        labeled("Pick one", column([radio(s.choice === 0, "First", () => { s.choice = 0 }), radio(s.choice === 1, "Second", () => { s.choice = 1 })], 6)),
        labeled("Volume", slider(s.volume, (v) => { s.volume = v })),
        segmented(["Day", "Week", "Month"], s.seg, (i) => { s.seg = i }),
        labeled("Progress", progress(s.volume)),
        labeled("Load", meter(s.volume)),
        labeled("Name", input(s.name, { placeholder: "Your name" })),
        labeled("Age", row([numberInput(s.age, (d) => { s.age.s = `${(parseInt(s.age.s) ?? 0) + d}` }), stepper((d) => { s.age.s = `${(parseInt(s.age.s) ?? 0) + d}` })], 4)),
        labeled("Notes", textarea(s.notes, 60)),
        labeled("Search", searchField(s.q)),
        row([spinner(20), text("loading…", { color: "#6e6e73" })], 8),
        link("github.com/aleclarson/mytov", "https://github.com/aleclarson/mytov"),
        list(200, 24, (i) => text(`row ${i}`, { color: i % 2 === 0 ? "#111111" : "#555555" }), s.listScroll),
        row([
          button("Dialog", () => { s.showDialog = true }),
          button("Toast", () => { s.showToast = true }),
          button("Drawer", () => { s.drawerOpen = !s.drawerOpen }),
        ], 8),
      ],
      12,
    ),
  )
  const menu = menuAt(base, ["Copy", "Paste", "Inspect"], s.ctxAt, () => { s.ctxAt = undefined })
  const dlg = modal(menu, column([
    text("A dialog", { size: 16, bold: true }),
    button("Close", () => { s.showDialog = false }),
  ], 10), s.showDialog)
  const drw = drawer(dlg, column([text("Inspector", { bold: true }), text("side panel")], 8), s.drawerOpen, 220)
  return on(toast(drw, "Saved", s.showToast), {
    rightClick: (x, y) => {
      try {
        showMenu([
          { label: "First", action: () => console.log("menu: first") },
          { label: "Second", action: () => console.log("menu: second") },
          { separator: true, label: "" },
          { label: "Third", action: () => console.log("menu: third") },
        ], x, y)
      } catch (e) {
        console.error(`mytov menu: ${e.message}`)
      }
    },
  })
}

try run({ title: "Widgets", width: 440, height: 420, view })
try setMenus([
  {
    title: "Edit",
    items: [
      { label: "Show Toast", shortcut: "cmd+t", action: () => { s.showToast = true } },
      { separator: true, label: "" },
      { label: "Close Drawer", shortcut: "cmd+shift+d", action: () => { s.drawerOpen = false } },
    ],
  },
])
