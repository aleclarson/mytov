import { button, column, damageRects, hitAt, layout, measure, text } from "../src/mytov"

test("column measures its children plus gaps", () => {
  const v = column([text("a"), text("bb")], 10)
  const s = measure(v)
  expect(s.h).toBe(15 * 1.35 * 2 + 10)
})

test("column centers the stack vertically and children horizontally", () => {
  const v = column([text("hi")], 0)
  const l = layout(v, 200, 100)
  const cmd = l.frame.frame[0]!
  if (cmd.kind === "text") {
    expect(cmd.w).toBe(2 * 15 * 0.55)
    expect(cmd.y).toBe((100 - 15 * 1.35) / 2)
    expect(cmd.x).toBe((200 - 2 * 15 * 0.55) / 2)
  } else {
    expect(true).toBe(false)
  }
})

test("a button registers a focusable hit region over its rect", () => {
  const v = column([button("Increment", () => {})], 0)
  const l = layout(v, 200, 100)
  expect(l.hits.length).toBe(1)
  const b = l.hits[0]!.box
  expect(b.h).toBe(30)
  expect(l.hits[0]!.on.focusable).toBe(true)
})

test("hitAt finds the topmost region or -1", () => {
  const v = column([text("hi"), button("B", () => {})], 0)
  const l = layout(v, 200, 100)
  const b = l.hits[0]!.box
  expect(hitAt(b.x + 1, b.y + 1, l.hits)).toBe(0)
  expect(hitAt(0, 0, l.hits)).toBe(-1)
})

test("pressed and focused buttons draw differently", () => {
  const v = column([button("B", () => {})], 0)
  const plain = layout(v, 200, 100)
  const styled = layout(v, 200, 100, { hover: -1, pressed: 0, focus: 0 })
  const a = plain.frame.frame[0]!
  const b = styled.frame.frame[0]!
  const ring = styled.frame.frame[1]!
  if (a.kind === "rect" && b.kind === "rect" && ring.kind === "rect") {
    expect(a.color).toBe("#0a7aff")
    expect(b.color).toBe("#045cc4")
    expect(ring.stroke).toBe("#6bb3ff")
  } else {
    expect(true).toBe(false)
  }
})

test("damageRects covers only changed commands", () => {
  const v1 = column([text("0"), button("B", () => {})], 0)
  const v2 = column([text("1"), button("B", () => {})], 0)
  const a = layout(v1, 200, 100).frame.frame
  const b = layout(v2, 200, 100).frame.frame
  const dmg = damageRects(a, b)
  expect(dmg.length).toBe(2) // old + new text box
  expect(dmg[0]!.h).toBe(15 * 1.35)
  const none = damageRects(a, a)
  expect(none.length).toBe(0)
})
